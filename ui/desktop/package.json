{
  "name": "biorouter-app",
  "productName": "Biorouter",
  "version": "1.90.3",
  "description": "Biorouter App",
  "engines": {
    "node": "^24.0.0"
  },
  "main": ".vite/build/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate-api": "openapi-ts",
    "build:web": "vite build --config vite.renderer.config.mts --outDir src/web --emptyOutDir",
    "start-gui": "npm run generate-api && electron-forge start",
    "start-gui-debug": "npm run generate-api && electron-forge start -- --inspect=9229",
    "start": "cd ../.. && just run-ui",
    "start:test-error": "BIOROUTER_TEST_ERROR=true electron-forge start",
    "package": "node scripts/check-package-prereqs.mjs && node scripts/fix-node-pty-permissions.mjs && electron-forge package",
    "make": "node scripts/check-package-prereqs.mjs && node scripts/fix-node-pty-permissions.mjs && electron-forge make",
    "bundle:default": "node scripts/build-auth-helper.mjs && node scripts/prepare-platform-binaries.js && npm run make && (cd out/Biorouter-darwin-arm64 && ditto -c -k --sequesterRsrc --keepParent Biorouter.app Biorouter.zip)",
    "bundle:alpha": "ALPHA=true node scripts/prepare-platform-binaries.js && ALPHA=true npm run make && (cd out/Biorouter-darwin-arm64 && ditto -c -k --sequesterRsrc --keepParent Biorouter.app Biorouter_alpha.zip) || echo 'out/Biorouter-darwin-arm64 not found; either the binary is not built or you are not on macOS'",
    "bundle:windows": "node scripts/build-windows.js",
    "bundle:intel": "ELECTRON_ARCH=x64 node scripts/build-auth-helper.mjs && ELECTRON_ARCH=x64 node scripts/prepare-platform-binaries.js && npm run make -- --arch=x64 && cd out/Biorouter-darwin-x64 && ditto -c -k --sequesterRsrc --keepParent Biorouter.app Biorouter_intel_mac.zip",
    "bundle:dmg": "node scripts/prepare-platform-binaries.js && npm run make -- --targets @electron-forge/maker-dmg",
    "bundle:intel-dmg": "ELECTRON_ARCH=x64 node scripts/prepare-platform-binaries.js && npm run make -- --targets @electron-forge/maker-dmg --arch=x64",
    "bundle:linux": "ELECTRON_PLATFORM=linux npm run make -- --platform=linux --arch=x64",
    "debug": "echo 'run --remote-debugging-port=8315' && lldb out/Biorouter-darwin-arm64/Biorouter.app",
    "build:e2e": "node scripts/build-e2e.mjs",
    "test-e2e": "npm run generate-api && npm run build:e2e && playwright test",
    "test-e2e:dev": "npm run generate-api && npm run build:e2e && playwright test --reporter=list --retries=0 --max-failures=1",
    "test-e2e:ui": "npm run generate-api && npm run build:e2e && playwright test --ui",
    "test-e2e:debug": "npm run generate-api && npm run build:e2e && playwright test --debug",
    "test-e2e:report": "playwright show-report",
    "test-e2e:single": "npm run generate-api && npm run build:e2e && playwright test -g",
    "test:preview-panel": "node scripts/preview-panel-e2e.mjs",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --fix --no-warn-ignored",
    "lint:check": "npm run typecheck && eslint \"src/**/*.{ts,tsx}\" --max-warnings 0 --no-warn-ignored && npm run check:themes && npm run check:contrast && npm run check:tokens",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "postinstall": "node scripts/fix-node-pty-permissions.mjs",
    "start-alpha-gui": "ALPHA=true npm run start-gui",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:tokens": "node scripts/check-token-mirrors.mjs",
    "themes": "node scripts/generate-themes.mjs",
    "check:themes": "node scripts/generate-themes.mjs --check",
    "cdp:viewport-check": "node scripts/cdp-viewport-check.mjs"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "^1.2.4",
    "@mcp-ui/client": "^5.17.3",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/themes": "^3.2.1",
    "@tanstack/react-form": "^1.27.7",
    "@types/react-router-dom": "^5.3.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "adm-zip": "^0.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compare-versions": "^6.1.1",
    "cors": "^2.8.5",
    "cronstrue": "^3.9.0",
    "d3-force": "^3.0.0",
    "date-fns": "^4.1.0",
    "docx-preview": "^0.4.0",
    "dotenv": "^17.2.3",
    "electron-log": "^5.4.3",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.8.9",
    "electron-window-state": "^5.0.3",
    "express": "^5.2.1",
    "js-yaml": "^5.3.0",
    "katex": "^0.16.27",
    "lodash": "^4.17.21",
    "lucide-react": "^0.562.0",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^6.2.108",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-force-graph-2d": "^1.27.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "react-select": "^5.10.2",
    "react-syntax-highlighter": "^16.1.0",
    "react-toastify": "^11.0.5",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shell-quote": "^1.8.3",
    "split-type": "^0.3.4",
    "swr": "^2.3.8",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "unist-util-visit": "^5.0.0",
    "utif2": "^4.1.0",
    "uuid": "^13.0.0",
    "xlsx-preview": "^1.0.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-flatpak": "^7.10.2",
    "@electron-forge/maker-rpm": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.10.2",
    "@electron-forge/plugin-fuses": "^7.10.2",
    "@electron-forge/plugin-vite": "^7.10.2",
    "@electron/fuses": "^1.8.0",
    "@electron/remote": "^2.1.3",
    "@eslint/js": "^9.39.2",
    "@hey-api/openapi-ts": "^0.90.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/adm-zip": "^0.5.8",
    "@types/cors": "^2.8.19",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.17.23",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/shell-quote": "^1.7.5",
    "@types/yauzl": "^2.10.3",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.17",
    "@vitest/ui": "^4.0.17",
    "autoprefixer": "^10.4.23",
    "electron": "^39.8.10",
    "electron-devtools-installer": "^4.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "14.0.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "knip": "^5.80.2",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.17"
  },
  "keywords": [],
  "license": "Apache-2.0",
  "overrides": {
    "@hono/node-server": "1.19.15",
    "body-parser": "2.3.0",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "exceljs": {
      "uuid": "11.1.1"
    },
    "fast-uri": "3.1.5",
    "hono": "4.13.3",
    "ip-address": "10.5.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "bash -c 'npm run typecheck'",
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "src/**/*.{css,json}": [
      "prettier --write"
    ]
  }
}
