__pycache__
*.pyc
*.jar
.DS_Store
.idea
*.log
tmp/

logs/
# Generated by Cargo
# will have compiled files and executables
debug/
target/
.biorouter/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# UI
ui/desktop/node_modules/
ui/desktop/out/
# Staged binaries for Electron packaging (compiled, >100MB)
ui/desktop/src/bin/

# Hermit toolchain environment
.hermit/

# Registry generator: the lock a real run holds while it renames its three
# outputs into place. Removed in a `finally`; only a crash can leave one behind.
landing/.registry-build.lock

# Claude
.claude

# Playwright MCP session cache and debug artifacts
.playwright-mcp/
.mcp.json

# Superpowers plugin session data
.superpowers/

# Frontend build output
ui/desktop/dist/

# Root-level screenshot debug artifacts
*.png
# …but the CLI ships these via include_bytes! and they must be tracked
!crates/biorouter-cli/static/img/logo_dark.png
!crates/biorouter-cli/static/img/logo_light.png

# Sensitive credentials — never commit
notarization/

debug_*.txt

# Error log artifacts from mcp replay tests
crates/biorouter/tests/mcp_replays/*errors.txt

# Artifact written by the ACP builtin-and-mcp integration test (runs in the
# crate dir, so the sandbox's result.txt lands here)
crates/biorouter-acp/result.txt

# Nix build output
result
/node_modules/
.codegraph

# Local agent tooling config (not product source)
.codex/
# Codex-style migrated skills (`.agents/skills/…`): local agent tooling, like .claude and .codex
.agents/

dist/

# Secrets — never commit. `*.env` covers every per-extension env file, so
# individual ones do not need their own line.
*.env
config.yaml.bak.*

# Packaged extension artifacts (build output, not product source)
*.brxt
# The Agent Drafter stress test writes generated apps here; the run is
# resumable, so this stays even while the directory is absent.
biorouter-testing-apps/

# Signing certificates — never commit (also covered by notarization/)
*.p12

# Test-drive runtime: drafted apps, daemon logs (which contain the spawn env,
# including provider API keys), and an embedded KB git repo. Never committed.
.br-testdrive/

# Machine-local git-worktree layout snapshot (see scripts/worktrees.sh); keep per-clone, do not commit
scripts/worktrees.manifest
# The dev launcher symlinks ui/desktop/src/bin into a worktree; the trailing-slash pattern
# elsewhere matches only a real directory, so the symlink itself must be named too.
ui/desktop/src/bin
