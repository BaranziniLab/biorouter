+import Foundation
+import XCTest
+@testable import OpenComputerUseKit
+
+final class BiorouterContractTests: XCTestCase {
+    func testMCPAdvertisesOnlyTheTenToolContract() throws {
+        XCTAssertEqual(
+            ToolDefinitions.advertised.map(\.name).sorted(),
+            ["click", "drag", "get_app_state", "list_apps", "perform_secondary_action",
+             "press_key", "screen_capture", "scroll", "set_value", "type_text"]
+        )
+        for (name, omitted) in ToolDefinitions.biorouterOmittedArguments {
+            let tool = try XCTUnwrap(ToolDefinitions.advertised.first { $0.name == name })
+            let properties = try XCTUnwrap(tool.inputSchema["properties"] as? [String: Any])
+            for key in omitted { XCTAssertNil(properties[key], "\(name) advertises \(key)") }
+        }
+        let server = StdioMCPServer()
+        let line = #"{"jsonrpc":"2.0","id":1,"method":"tools/list"}"#
+        let response = try XCTUnwrap(server.handle(line: line))
+        let payload = try XCTUnwrap(JSONSerialization.jsonObject(with: Data(response.utf8)) as? [String: Any])
+        let tools = try XCTUnwrap((payload["result"] as? [String: Any])?["tools"] as? [[String: Any]])
+        XCTAssertEqual(tools.count, 10)
+    }
+
+    func testMCPRefusesCallsOutsideTheContractBeforeRunning() throws {
+        let server = StdioMCPServer()
+        for call in [
+            #"{"name":"query","arguments":{"app":"missing-fixture","text":"x"}}"#,
+            #"{"name":"select_text","arguments":{"app":"missing-fixture","element_index":"1","text":"x"}}"#,
+            #"{"name":"get_app_state","arguments":{"app":"missing-fixture","include_screenshot":false}}"#,
+            #"{"name":"press_key","arguments":{"app":"missing-fixture","key":"a","key_method":"sky_key"}}"#,
+        ] {
+            let response = try XCTUnwrap(server.handle(line: #"{"jsonrpc":"2.0","id":1,"method":"tools/call","params":"# + call + "}"))
+            let payload = try XCTUnwrap(JSONSerialization.jsonObject(with: Data(response.utf8)) as? [String: Any])
+            let result = try XCTUnwrap(payload["result"] as? [String: Any])
+            XCTAssertEqual(result["isError"] as? Bool, true, call)
+            let text = ((result["content"] as? [[String: Any]])?.first?["text"] as? String) ?? ""
+            XCTAssertTrue(text.contains("Unknown tool") || text.contains("does not accept"), text)
+        }
+    }
+
+    func testLockedMacIsRefusedWithoutLockedUse() {
+        XCTAssertThrowsError(try requireUsableComputerUseSession(LockedUseSession(state: .locked, userID: 501, auditSessionID: 1))) { error in
+            XCTAssertTrue(String(describing: error).contains("does not operate a locked Mac"))
+        }
+    }
+}
