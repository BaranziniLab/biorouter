+// Biorouter Copilot's reviewed contract is what MCP advertises and accepts: these
+// tools without the observation toggles and keyboard delivery methods upstream
+// added. toolDefinitions keeps upstream's full schemas for its own tests and CLI.
+var biorouterOmittedArguments = map[string][]string{
+	"get_app_state": {"include_ax", "include_screenshot", "window_placement"},
+	"type_text":     {"key_method"},
+	"press_key":     {"key_method"},
+}
+
+func advertisedToolDefinitions() []toolDefinition {
+	tools := toolDefinitions()
+	for i, tool := range tools {
+		omitted := biorouterOmittedArguments[tool.Name]
+		if len(omitted) == 0 {
+			continue
+		}
+		schema := map[string]any{}
+		for key, value := range tool.InputSchema {
+			schema[key] = value
+		}
+		properties := map[string]any{}
+		for key, value := range tool.InputSchema["properties"].(map[string]any) {
+			properties[key] = value
+		}
+		for _, key := range omitted {
+			delete(properties, key)
+		}
+		schema["properties"] = properties
+		tools[i].InputSchema = schema
+	}
+	return tools
+}
+
+// unadvertisedCall names what a tools/call uses outside the advertised contract, before anything runs.
+func unadvertisedCall(name string, args map[string]any) string {
+	for _, tool := range advertisedToolDefinitions() {
+		if tool.Name != name {
+			continue
+		}
+		properties, _ := tool.InputSchema["properties"].(map[string]any)
+		keys := make([]string, 0, len(args))
+		for key := range args {
+			keys = append(keys, key)
+		}
+		sort.Strings(keys)
+		for _, key := range keys {
+			if _, ok := properties[key]; !ok {
+				return name + " does not accept " + key
+			}
+		}
+		return ""
+	}
+	return "Unknown tool: " + name
+}
