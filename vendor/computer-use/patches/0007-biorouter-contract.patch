+    /// What the MCP server advertises and accepts: Biorouter Copilot's reviewed
+    /// ten-tool contract. Upstream's query and select_text tools, its observation
+    /// toggles, agent-display window placement and keyboard delivery methods are
+    /// not part of it; they stay in `all` for upstream's own CLI and tests.
+    public static var advertised: [ToolDefinition] {
+        biorouterContract(all)
+    }
+
+    static let biorouterToolNames: Set<String> = [
+        "list_apps", "get_app_state", "click", "perform_secondary_action", "scroll",
+        "drag", "type_text", "press_key", "set_value", "screen_capture",
+    ]
+
+    static let biorouterOmittedArguments: [String: Set<String>] = [
+        "get_app_state": ["include_ax", "include_screenshot", "window_placement"],
+        "type_text": ["key_method"],
+        "press_key": ["key_method"],
+    ]
+
+    static func biorouterContract(_ tools: [ToolDefinition]) -> [ToolDefinition] {
+        tools.filter { biorouterToolNames.contains($0.name) }.map { tool in
+            guard let omitted = biorouterOmittedArguments[tool.name] else { return tool }
+            var schema = tool.inputSchema
+            var properties = schema["properties"] as? [String: Any] ?? [:]
+            for key in omitted { properties.removeValue(forKey: key) }
+            schema["properties"] = properties
+            return ToolDefinition(name: tool.name, description: tool.description, annotations: tool.annotations, inputSchema: schema)
+        }
+    }
+
+    /// Refuses a call outside the advertised contract before anything runs.
+    static func requireAdvertised(name: String, arguments: [String: Any]) throws {
+        guard let tool = advertised.first(where: { $0.name == name }) else {
+            throw ComputerUseError.invalidArguments("Unknown tool: \(name)")
+        }
+        let accepted = (tool.inputSchema["properties"] as? [String: Any]) ?? [:]
+        if let unexpected = arguments.keys.sorted().first(where: { accepted[$0] == nil }) {
+            throw ComputerUseError.invalidArguments("\(name) does not accept \(unexpected)")
+        }
+    }
