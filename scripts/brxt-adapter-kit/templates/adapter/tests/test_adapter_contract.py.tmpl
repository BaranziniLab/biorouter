"""Contract tests every adapter built on the BRXT adapter kit runs in CI.

Generated by the kit. Add this service's own tests in other files next to it;
leave this one as it is so every adapter keeps the same floor:

* the vendored kit is unchanged;
* uv.lock pins fastmcp 4 and this version of the project;
* every release rule of scripts/build_brxt.py holds;
* the server starts over stdio and lists the declared tools;
* the leak suite: every credential reaches only its own host, a full URL or a
  redirect to another host is refused, reads never send a write method;
* the adapter's own code opens no network connection and runs no command
  except through the kit.
"""

import hashlib
import json
import re
import subprocess
import sys
import tempfile
import tomllib
import unittest
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
PACKAGE = "@@PKG@@"
SOURCE = ROOT / "src" / PACKAGE
sys.path.insert(0, str(ROOT / "src"))
sys.path.insert(0, str(Path(__file__).resolve().parent))

from kit_testing import leak_suite, stdio_probe  # noqa: E402

MANIFEST = json.loads((ROOT / "manifest.json").read_text(encoding="utf-8"))
SPEC_DATA = json.loads((SOURCE / "adapter.json").read_text(encoding="utf-8"))

# The adapter's own modules reach the network and run programs only through the
# kit. A file may opt out with a line "# brxt-kit: allow-direct-network <reason>",
# which a reviewer must accept.
FORBIDDEN = re.compile(
    r"^\s*(?:import|from)\s+(httpx|requests|urllib\.request|urllib3|http\.client|aiohttp|pycurl|socket|subprocess)\b"
    r"|\bos\.(?:system|popen|exec\w*|spawn\w*)\s*\(",
    re.M,
)


class AdapterContract(unittest.TestCase):
    def test_vendored_kit_is_unchanged(self):
        record = json.loads((SOURCE / "_kit" / "vendored.json").read_text(encoding="utf-8"))
        self.assertTrue(record["files"], "vendored.json lists no files")
        for relative, digest in record["files"].items():
            path = ROOT / relative
            self.assertTrue(path.is_file(), f"{relative} is missing")
            self.assertEqual(hashlib.sha256(path.read_bytes()).hexdigest(), digest, f"{relative} was edited")

    def test_lock_pins_fastmcp_4_and_this_version(self):
        lock = tomllib.loads((ROOT / "uv.lock").read_text(encoding="utf-8"))
        fastmcp = [p["version"] for p in lock["package"] if p["name"] == "fastmcp"]
        self.assertTrue(fastmcp and all(v.startswith("4.") for v in fastmcp), fastmcp)
        own = [p for p in lock["package"] if p["name"] == MANIFEST["name"]]
        self.assertEqual(own[0]["version"], MANIFEST["version"])

    def test_release_rules_hold(self):
        result = subprocess.run(
            [sys.executable, str(ROOT / "scripts" / "build_brxt.py"), "--check"],
            cwd=ROOT,
            capture_output=True,
            text=True,
            timeout=300,
        )
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)

    def test_server_starts_over_stdio(self):
        with tempfile.TemporaryDirectory() as tmp:
            log = Path(tmp) / "stderr.log"
            found = stdio_probe.probe([sys.executable, "-m", PACKAGE], env=stdio_probe.clean_env(), cwd=str(ROOT), log_file=log)
        self.assertEqual(len(found["tools"]), MANIFEST["tools_count"], found["tools"])
        service = SPEC_DATA["service"]
        self.assertIn(f"{service}_status", found["tools"])
        if SPEC_DATA["kind"] != "tombstone":
            self.assertIn(f"{service}_get", found["tools"])
        else:
            self.assertEqual(found["tools"], [f"{service}_status"])
        if SPEC_DATA["kind"] in {"sunset", "tombstone"}:
            self.assertIn(SPEC_DATA["notice"]["use_instead"], found["instructions"])
            self.assertIn(SPEC_DATA["notice"]["use_instead"], found["status_text"])

    def test_leak_suite(self):
        if SPEC_DATA["kind"] == "tombstone":
            self.skipTest("a tombstone has no targets; test_tombstone_reads_no_credential covers it")
        report = leak_suite.run_in_process(SPEC_DATA, kit_package=f"{PACKAGE}._kit", version=MANIFEST["version"])
        report.assert_clean()

    def test_tombstone_reads_no_credential(self):
        if SPEC_DATA["kind"] != "tombstone":
            self.skipTest("only a tombstone")
        self.assertEqual(MANIFEST["env_vars"], [])
        planted = {f"PLANTED_{i}": f"planted-secret-{i}-0123456789" for i in range(3)}
        env = {**stdio_probe.clean_env(), **planted}
        with tempfile.TemporaryDirectory() as tmp:
            log = Path(tmp) / "stderr.log"
            found = stdio_probe.probe([sys.executable, "-m", PACKAGE], env=env, cwd=str(ROOT), log_file=log)
            for value in planted.values():
                self.assertNotIn(value, found["status_text"])
                self.assertNotIn(value, log.read_text(encoding="utf-8", errors="replace"))

    def test_adapter_code_uses_only_the_kit_for_network_and_commands(self):
        offenders = []
        for path in sorted(SOURCE.rglob("*.py")):
            if "_kit" in path.relative_to(SOURCE).parts or "__pycache__" in path.parts:
                continue
            text = path.read_text(encoding="utf-8")
            if "# brxt-kit: allow-direct-network" in text:
                continue
            if FORBIDDEN.search(text):
                offenders.append(path.relative_to(ROOT).as_posix())
        self.assertEqual(offenders, [], "use the kit's SafeHttpClient; the Developer shell is the one command runner")


if __name__ == "__main__":
    unittest.main()
