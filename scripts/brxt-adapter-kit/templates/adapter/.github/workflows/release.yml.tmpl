# Generated by the Biorouter BRXT adapter kit @@KIT_VERSION@@.
# A GitHub release is a deploy: the desktop updater installs releases/latest of
# this repository at the next launch, with no prompt. Push a tag only after the
# checks pass and the release has been approved.
name: Publish BRXT
on:
  push:
    tags: ["v[0-9]*"]
permissions:
  contents: write
jobs:
  release:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5
      - uses: astral-sh/setup-uv@v6
        with:
          version: "@@UV_VERSION@@"
      - name: Refuse a tag that is not v plus the manifest version
        env:
          RELEASE_TAG: ${{ github.ref_name }}
        run: |
          version=$(python3 -c 'import json; print(json.load(open("manifest.json"))["version"])')
          if [ "$RELEASE_TAG" != "v$version" ]; then
            echo "Tag $RELEASE_TAG does not equal v$version from manifest.json" >&2
            exit 1
          fi
          echo "VERSION=$version" >> "$GITHUB_ENV"
      - name: The lock matches pyproject.toml
        run: uv lock --check
      - run: uv sync --locked --python 3.13
      - run: uv run python -m unittest discover -s tests -v
      - name: Fetch the previous release bundle, if there is one
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          mkdir -p previous
          if gh release view --repo "$GITHUB_REPOSITORY" >/dev/null 2>&1; then
            gh release download --repo "$GITHUB_REPOSITORY" --pattern "@@ID@@.brxt" --dir previous
          else
            echo "No earlier release: skipping the bundled skill path check."
          fi
      - name: Build, keeping every bundled skill path of the previous release
        run: |
          if [ -f previous/@@ID@@.brxt ]; then
            uv run python scripts/build_brxt.py --previous previous/@@ID@@.brxt
          else
            uv run python scripts/build_brxt.py
          fi
      - name: Publish the stable and versioned assets
        env:
          GH_TOKEN: ${{ github.token }}
          RELEASE_TAG: ${{ github.ref_name }}
        run: |
          gh release create "$RELEASE_TAG" \
            "dist/@@ID@@.brxt" "dist/@@ID@@-$VERSION.brxt" dist/SHA256SUMS \
            --title "@@DISPLAY_NAME@@ $RELEASE_TAG" --generate-notes --latest
