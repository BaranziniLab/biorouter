      "body": "<!doctype html>\n<html lang=\"en\">\n  <head><base href=\"./\">\n    <meta charset=\"UTF-8\"/>\n    <!--\n      BR-71 \u00a74.3 \u2014 connect-src carries TWO WebSocket sources, and both are load-bearing.\n      CSP will not stretch one scheme over another except on CSP3 \u00a76.6.2.6's short list\n      (http\u2192https, ws\u2192wss/http/https, wss\u2192https). So `http://127.0.0.1:*` does NOT cover\n      the loopback workspace socket and `https:` does NOT cover an external TLS backend's\n      socket; each needs naming. Missing either blocks `hooks/useWorkspaceChannel.ts`\n      before the request leaves the renderer, and every `workspace_list` then reports\n      `gui_attached: false` with the app on screen \u2014 the whole GUI half silently inert.\n      This policy and `buildConnectSrc()` in src/main.ts BOTH apply to the window and the\n      stricter wins, so they must stay in step; `src/workspaceChannelCsp.test.ts` pins it.\n      \u26a0 \"BOTH apply\" became true only in September 2026. Until then this window rendered in\n      a `persist:` partition while every hook \u2014 the header included \u2014 sat on\n      `session.defaultSession`, a different Session object, so this meta tag was the ONLY\n      policy enforcing. `src/rendererSessionHooks.test.ts` pins the mechanism that makes the\n      sentence true; a pin on the policy strings cannot see which of them is live.\n      `wss:` is blanket where `ws:` is loopback-only, mirroring this policy's own\n      cleartext-vs-TLS asymmetry for http (`http://127.0.0.1:*` vs blanket `https:`).\n\n      `frame-src` is `'self'` alone: every frame this document creates is `srcdoc`,\n      and the `blob: https: http:` it carried until September 2026 was dead \u2014 see the\n      comment on the same directive in src/main.ts. The two must move together, which\n      `src/frameSrcCsp.test.ts` pins.\n    -->\n    <meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; img-src 'self' data: blob: https:; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* https: wss:; object-src 'none'; font-src 'self' data: https:; media-src 'self' mediastream:; form-action 'none'; base-uri 'self'; manifest-src 'self'; worker-src 'self'; frame-src 'self';\"/>\n    <title>Biorouter</title>\n    <!--\n      Relative on purpose. Vite emits it beside the bundle and rewrites this to\n      `./assets/icon-<hash>.png`, which resolves against the `<base href>` the\n      daemon writes, so a browser behind a proxy's path prefix asks for it\n      under the prefix. Without a link at all a browser asks for `/favicon.ico`\n      at the host's root, outside the prefix. Electron ignores it.\n    -->\n    <link rel=\"icon\" type=\"image/png\" href=\"./assets/icon-BsQmrB9h.png\" />\n    <script>\n      // Initialize theme before any content loads\n      (function () {\n        function initializeThemeFamily() {\n          // The theme *family* (Parchment / Alma Mater / Roche Limit) is a\n          // `data-theme` attribute, orthogonal to the dark class. Set it before\n          // first paint so a non-default family does not flash Parchment on load.\n          //\n          // This list duplicates THEME_FAMILIES in src/contexts/ThemeContext.tsx\n          // on purpose \u2014 this script runs ahead of the bundle and cannot import\n          // TypeScript. Keep the two in lockstep when adding a family.\n          /* THEMES:GENERATED:FAMILYLIST:START */\n          const FAMILIES = ['parchment', 'alma-mater', 'roche-limit'];\n/* THEMES:GENERATED:FAMILYLIST:END */\n          try {\n            const stored = window.localStorage && localStorage.getItem('theme_family');\n            const fam = FAMILIES.indexOf(stored) !== -1 ? stored : 'parchment';\n            document.documentElement.setAttribute('data-theme', fam);\n          } catch (error) {\n            document.documentElement.setAttribute('data-theme', 'parchment');\n          }\n        }\n\n        // Stamp the page's mode on <html> as a class, `dark` OR `light`, never\n        // neither. ThemeContext tells a theme CHANGE from a mount by asking\n        // whether the class it is about to apply is already there; a light page\n        // used to carry no class at all, so every light mount looked like a\n        // change and stilled every transition on <html> for two frames, which\n        // included the boot splash's own 260 ms fade-out (vision FR-R4-1). The\n        // two branches below and ThemeContext's answer to \"which mode?\" must\n        // stay the same question, as loadThemePreference there already says.\n        function applyMode(isDark) {\n          const root = document.documentElement;\n          root.classList.add(isDark ? 'dark' : 'light');\n          root.classList.remove(isDark ? 'light' : 'dark');\n        }\n\n        function initializeTheme() {\n          initializeThemeFamily();\n          try {\n            if (window.localStorage) {\n              const useSystemTheme = localStorage.getItem('use_system_theme') === 'true';\n              const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;\n              const savedTheme = localStorage.getItem('theme');\n              applyMode(useSystemTheme ? systemPrefersDark : (savedTheme ? savedTheme === 'dark' : systemPrefersDark));\n            } else {\n              applyMode(window.matchMedia('(prefers-color-scheme: dark)').matches);\n            }\n          } catch (error) {\n            console.warn('Failed to initialize theme from localStorage, using system preference:', error);\n            applyMode(window.matchMedia('(prefers-color-scheme: dark)').matches);\n          }\n        }\n\n        // Apply the text preference before the first paint.\n        try {\n          const sizes = { standard: 1, large: 1.07, larger: 1.15 };\n          const stored = localStorage.getItem('app_font_size');\n          const size = Object.prototype.hasOwnProperty.call(sizes, stored) ? stored : 'standard';\n          document.documentElement.dataset.fontSize = size;\n          document.documentElement.style.setProperty('--app-font-scale', String(sizes[size]));\n        } catch (error) {\n          document.documentElement.dataset.fontSize = 'standard';\n          document.documentElement.style.setProperty('--app-font-scale', '1');\n        }\n\n        // Run immediately\n        initializeTheme();\n\n        // Retry after DOM is ready if initial attempt failed\n        if (document.readyState === 'loading') {\n          document.addEventListener('DOMContentLoaded', function() {\n            setTimeout(initializeTheme, 50);\n          });\n        }\n      })();\n    </script>\n    <style id=\"br-boot-splash-style\">\n      /* \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n         BOOT SPLASH \u2014 the screen shown while the app is still starting.\n\n         Lives here, ahead of React, on purpose. `renderer.tsx` awaits\n         `getBiorouterdHostPort()` *before* it calls `createRoot().render()`,\n         so during backend startup \u2014 the slow case this screen exists for \u2014\n         React has not run and a <Suspense> fallback cannot paint. Only\n         pre-React markup can cover that window.\n\n         It reads the `data-theme` / `dark` state the script above already\n         stamped on <html>, so it is theme-correct from the first frame.\n         Spec: docs/superpowers/specs/2026-07-18-boot-splash-design.md\n         \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 */\n      #br-boot {\n        /* The page ground, light.\n\n           These are LITERAL values, not var(--background-canvas) and friends,\n           for a reason of TIMING: this splash paints before the stylesheet has\n           been applied (in dev, Vite injects main.css via JS after first\n           paint), so a var() here would resolve to its fallback during exactly\n           the window the splash exists to fill. The tokens themselves are\n           ordinary custom properties; only their availability at this moment is\n           the problem. (An earlier version of this comment blamed Tailwind's\n           `@theme inline` for compiling them away. That is false.)\n\n           THE GROUND IS THE PAGE'S. `--br-bg` is `--background-canvas`, the\n           ground the first-run page, Home and the loader between them all paint.\n           It used to be `--background-muted`, a grey one step off that ground,\n           so a launch that crossed the threshold flashed grey before it faded\n           onto white (vision FR-R1-7, R-34). `--background-app`, the window\n           behind everything, is the same value today; the canvas is the one a\n           person is looking at when this fades out.\n\n           THE INKS ARE THE WORDMARK'S, AND THEY DO NOT FOLLOW THE FAMILY. What\n           is drawn below is the Biorouter wordmark (R-29: the text logo is the\n           logo), and `icons/BioRouterWordmark.tsx` is deliberately fixed to the\n           brand colours in every family, so a splash that took Alma Mater's\n           teal or Roche Limit's orange would hand off to a differently coloured\n           logo one frame later. `npm run themes` writes every rule inside the\n           THEMES:GENERATED:SPLASH region below: each family's own canvas, and\n           the BASE family's mark inks for all of them. Edit the theme\n           definitions, not that region.\n\n           THIS BLOCK IS THE EXCEPTION. These four values are the base family,\n           light, and they are hand-written because this `#br-boot` rule is also\n           the base every other rule cascades from: emitting a generated\n           `html #br-boot` duplicate would give one ground two rules. They are\n           pinned to parchment.theme.mjs, and the inks to the wordmark's own\n           constants, by boot-splash.test.ts, so they cannot drift.\n\n           EVERY theme family needs a light and a dark rule below.\n           boot-splash.test.ts cross-checks this list against THEME_FAMILIES in\n           src/contexts/ThemeContext.tsx and fails if one is missing, so adding\n           a family cannot silently regress this screen. */\n        --br-bg: #ffffff;\n        --br-navy: #052049;\n        --br-coral: #b85a32;\n        --br-track: #e4e4e0;\n\n        position: fixed;\n        inset: 0;\n        z-index: 2147483000;\n        display: flex;\n        flex-direction: column;\n        align-items: center;\n        justify-content: center;\n        /* NO `gap`, and the sweep is NOT in this flow, see .br-sweep below. The\n           wordmark must be the ONLY in-flow child so that centring this column\n           centres the WORDMARK, not the wordmark-plus-sweep stack. */\n        background: var(--br-bg);\n        opacity: 1;\n        transition: opacity 260ms cubic-bezier(0.2, 0, 0, 1);\n      }\n      /* `hidden` must beat the flex display above, hence the id+attr selector. */\n      #br-boot[hidden] { display: none; }\n      #br-boot.br-out { opacity: 0; }\n\n      /* THEMES:GENERATED:SPLASH:START */\n      html.dark #br-boot {\n        --br-bg: #131312;\n        --br-navy: #18a3ac;\n        --br-coral: #b85a32;\n        --br-track: #302f2c;\n      }\n      html[data-theme='alma-mater'] #br-boot {\n        --br-bg: #ffffff;\n        --br-navy: #052049;\n        --br-coral: #b85a32;\n        --br-track: #e4e4e0;\n      }\n      html.dark[data-theme='alma-mater'] #br-boot {\n        --br-bg: #131312;\n        --br-navy: #18a3ac;\n        --br-coral: #b85a32;\n        --br-track: #302f2c;\n      }\n      html[data-theme='roche-limit'] #br-boot {\n        --br-bg: #ffffff;\n        --br-navy: #052049;\n        --br-coral: #b85a32;\n        --br-track: #e4e4e0;\n      }\n      html.dark[data-theme='roche-limit'] #br-boot {\n        --br-bg: #131312;\n        --br-navy: #18a3ac;\n        --br-coral: #b85a32;\n        --br-track: #302f2c;\n      }\n/* THEMES:GENERATED:SPLASH:END */\n\n      /* The wordmark is drawn AT REST: no entrance, no stagger, no blur. A launch\n         surface appears whole (spec principle 9), and the only thing that moves\n         on this screen is the sweep below, a progress cue that stays inside\n         `transform`. The box is the viewBox's own ratio (486.55 x 149.05).\n\n         The `margin-top` centres the INK, not the box. The viewBox is padded\n         around the text's line box, which carries ascender room above the\n         capitals, so the lockup's ink (capital tops to the underline's bottom)\n         sits 4px BELOW the box centre. Measured in Chromium at 2x; -8px on the\n         only in-flow child lifts the box 4px, which puts the ink centre on the\n         window's centre. bootSplash.browser.test.ts holds it to 1px. */\n      #br-boot .br-wordmark { width: 160px; height: 49px; display: block; margin-top: -8px; }\n      /* Set in Inter (bundled @font-face in main.css), like the in-app wordmark\n         (`icons/brandFont.ts`), never the native UI stack. */\n      #br-boot .br-wordmark text {\n        font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, Roboto,\n          'Helvetica Neue', Arial, sans-serif;\n        font-weight: 600;\n        letter-spacing: 0;\n      }\n      #br-boot .br-navy { fill: var(--br-navy); }\n      #br-boot .br-coral { fill: var(--br-coral); }\n\n      /* The sweep is taken OUT OF THE FLEX FLOW on purpose, and anchored to the\n         viewport centre rather than to the wordmark.\n\n         It used to be a second in-flow child with a `gap` on the container. That\n         made the centred column taller than its logo, so the logo sat ABOVE the\n         true viewport centre while the very next screen (ProviderGuard's\n         loader) centred exactly, and handing off jumped the logo down 14px.\n         Measured, not guessed: ink centre y was 447.59 on the splash against\n         461.49 on the loader, in a 923px-tall viewport.\n\n         Anchoring here keeps the sweep a fixed distance BELOW the wordmark, but\n         it can no longer push the wordmark around. `#br-boot` is `position:\n         fixed`, so it is the containing block. Keep these numbers in sync with\n         `.br-wordmark`'s 49px height and -8px margin, and this rule's own\n         120px width. */\n      #br-boot .br-sweep {\n        position: absolute;\n        top: 50%;\n        left: 50%;\n        margin-top: calc(42px * var(--app-font-scale, 1)); /* the ink's lower half (about 18px) + a 24px gap */\n        margin-left: -60px; /* half of the 120px width */\n        width: 120px;\n        height: 2px;\n        border-radius: 2px;\n        background: var(--br-track);\n        overflow: hidden;\n      }\n      #br-boot .br-sweep i {\n        position: absolute;\n        inset: 0;\n        display: block;\n        border-radius: 2px;\n        background: linear-gradient(90deg, transparent, var(--br-navy), transparent);\n        transform: translateX(-100%);\n        animation: br-boot-sweep 1150ms cubic-bezier(0.4, 0, 0.2, 1) infinite;\n      }\n      @keyframes br-boot-sweep { to { transform: translateX(100%); } }\n\n      /* The wordmark is `aria-hidden`, so this line is the only thing announcing\n         the wait. Without it a slow boot is silent to a screen reader. */\n      #br-boot .br-sr {\n        position: absolute;\n        width: 1px;\n        height: 1px;\n        padding: 0;\n        margin: -1px;\n        overflow: hidden;\n        clip: rect(0, 0, 0, 0);\n        white-space: nowrap;\n        border: 0;\n      }\n\n      @media (prefers-reduced-motion: reduce) {\n        #br-boot .br-sweep i { animation: none; }\n      }\n\n      /* Chromium does not force an SVG `fill` it was given as a colour, so under\n         forced colours the navy half of the wordmark keeps its authored ink on\n         whatever canvas the person chose (measured on the in-app wordmark at\n         about 1.3:1). `CanvasText` is the one ink their palette guarantees. This\n         mirrors main.css's \"wordmark forced colours\" rule, restated here because\n         this block cannot wait for the stylesheet. */\n      @media (forced-colors: active) {\n        #br-boot .br-navy,\n        #br-boot .br-coral { fill: CanvasText; }\n      }\n    </style>\n    <script type=\"module\" crossorigin src=\"./assets/index-CobxLFtx.js\"></script>\n    <link rel=\"stylesheet\" crossorigin href=\"./assets/index-Dg9nAqgK.css\">\n  <script>window.__BIOROUTER_HEADLESS_CONFIG__={\"secretKey\":\"<SYNTHETIC_API_SECRET>\"};window.addEventListener('vite:preloadError',function(e){e.preventDefault();});</script></head>\n  <body>\n    <!-- br-boot:start -->\n    <div id=\"br-boot\" hidden>\n      <span class=\"br-sr\" role=\"status\">Loading Biorouter\u2026</span>\n      <!--\n        The Biorouter wordmark (R-29: the text logo is the logo), emitted as\n        static geometry rather than measured at runtime like\n        icons/BioRouterWordmark.tsx does. On the boot path there is no time to\n        wait for fonts before a getBBox() pass, and the numbers are deterministic\n        for Inter 600 anyway. To regenerate after a brand change, render\n        <BioRouterWordmark/> in a browser at 160 by 49 (the component's own\n        measurement moves by a few hundredths with its rendered size, so measure\n        it at the size drawn here) and copy the resulting viewBox, the two rects\n        and the text's size and weight. The navy rect is the WHOLE bar and\n        the coral one is drawn over its right half, as in the component, so no\n        anti-aliased seam can show between two rects that meet at a fraction.\n        `aria-hidden`: the status line above names the wait once; the lockup\n        would only read it a second time.\n      -->\n      <svg class=\"br-wordmark\" viewBox=\"-7.21 -103.38 486.55 149.05\" aria-hidden=\"true\" focusable=\"false\">\n        <text x=\"0\" y=\"0\" font-size=\"100\"><tspan class=\"br-navy\">Bio</tspan><tspan class=\"br-coral\">Router</tspan></text>\n        <rect class=\"br-navy\" x=\"92.03\" y=\"26.44\" width=\"124.85\" height=\"12.02\"/>\n        <rect class=\"br-coral\" x=\"152.93\" y=\"26.44\" width=\"63.95\" height=\"12.02\"/>\n      </svg>\n      <div class=\"br-sweep\"><i></i></div>\n    </div>\n    <!-- br-boot:end -->\n    <script id=\"br-boot-splash-script\">\n      /* Boot splash controller. Kept inline and dependency-free so it paints\n         without waiting on the module graph. `boot-splash.test.ts` extracts\n         and runs this exact source, so it is the tested artefact. */\n      (function () {\n        var THRESHOLD_MS = 400; // below this, a boot is fast enough to show nothing\n        var FONT_WAIT_MS = 250; // the longest the first frame waits for the brand face\n        var FADE_OUT_MS = 260;\n        // Dispatched on `window` once, when the splash is no longer on screen. The app reads it\n        // (`components/privacy/firstRunNoticeHandoff.ts` keeps the same spelling and\n        // boot-splash.test.ts pins the two together) so a dialog never opens under, or through,\n        // the fading wordmark (vision FR-R5-1).\n        var GONE_EVENT = 'br-boot-splash-gone';\n\n        var el = document.getElementById('br-boot');\n        if (!el) return;\n\n        var showTimer = null;\n        var removeTimer = null;\n        var shown = false;\n        var finished = false;\n        var gone = false;\n\n        // The splash appears at REST (spec principle 9, vision FR-R1-7): the\n        // wordmark is drawn whole in the first frame, so there is nothing to\n        // animate from script. The one moving part, the sweep, is a CSS\n        // animation that starts when `hidden` comes off and stops with\n        // `prefers-reduced-motion`; it dies with the element, so teardown has\n        // nothing to cancel.\n        function show() {\n          if (finished || shown) return;\n          shown = true;\n          showTimer = null;\n          el.hidden = false;\n        }\n\n        // Inter is `font-display: block` and is not requested until something\n        // paints with it, so a splash that came off `hidden` at once drew the\n        // bars of the lockup first and its letters a frame or more later\n        // (measured in Chromium: the face reads `unloaded` at the moment the\n        // splash is shown and `loaded` 10 to 20 ms after). Load it first, so\n        // the first frame is the whole logo. A face that is slow or missing\n        // never holds the splash past FONT_WAIT_MS, and no `document.fonts`\n        // (jsdom) shows it at once.\n        function showWhenFontReady() {\n          showTimer = null;\n          var fonts = document.fonts;\n          if (finished || !fonts || typeof fonts.load !== 'function') {\n            show();\n            return;\n          }\n          var released = false;\n          function release() {\n            if (released) return;\n            released = true;\n            show();\n          }\n          try {\n            fonts.load('600 100px Inter', 'BioRouter').then(release, release);\n          } catch (e) {\n            release();\n            return;\n          }\n          setTimeout(release, FONT_WAIT_MS);\n        }\n\n        function teardown() {\n          if (removeTimer) {\n            clearTimeout(removeTimer);\n            removeTimer = null;\n          }\n          if (el && el.parentNode) el.parentNode.removeChild(el);\n          if (gone) return;\n          gone = true;\n          try {\n            window.dispatchEvent(new Event(GONE_EVENT));\n          } catch (e) {\n            // No Event constructor: nothing was listening for it either. `isGone()` still answers.\n          }\n        }\n\n        // Called by renderer.tsx once React has actually mounted the app.\n        function dismiss() {\n          if (finished) return;\n          finished = true;\n          if (showTimer) {\n            clearTimeout(showTimer);\n            showTimer = null;\n          }\n          // Never crossed the threshold: drop it without a flash.\n          if (!shown) {\n            teardown();\n            return;\n          }\n          el.classList.add('br-out');\n          removeTimer = setTimeout(teardown, FADE_OUT_MS + 40);\n          el.addEventListener('transitionend', teardown, { once: true });\n        }\n\n        showTimer = setTimeout(showWhenFontReady, THRESHOLD_MS);\n\n        window.__brBootSplash = {\n          dismiss: dismiss,\n          isShown: function () {\n            return shown;\n          },\n          // True once the splash has left the screen: removed after its fade, or taken down\n          // before it was ever drawn. False from the first script run until then, so \"not gone\"\n          // covers the fade as well as the wait.\n          isGone: function () {\n            return gone;\n          },\n        };\n      })();\n    </script>\n    <div id=\"root\"></div>\n  </body>\n</html>\n",
      "response_truncated": false,
      "duration_ms": 1.485
    }
