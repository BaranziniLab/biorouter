+private func finiteNumericArgument(_ key: String, in arguments: [String: Any], defaultValue: Double) throws -> Double {
+    guard let raw = arguments[key] else { return defaultValue }
+    guard let number = raw as? NSNumber,
+          CFGetTypeID(number) != CFBooleanGetTypeID(),
+          number.doubleValue.isFinite else {
+        throw ComputerUseError.invalidArguments("\(key) must be a finite number; omit it to use the default")
+    }
+    return number.doubleValue
+}
+
+func scrollPagesArgument(in arguments: [String: Any]) throws -> Double {
+    let pages = try finiteNumericArgument("pages", in: arguments, defaultValue: 1)
+    try validateScrollPages(pages)
+    return pages
+}
+
+func clickCountArgument(in arguments: [String: Any]) throws -> Int {
+    let count = try finiteNumericArgument("click_count", in: arguments, defaultValue: 1)
+    guard count >= 1, count <= 100, let integer = Int(exactly: count) else {
+        throw ComputerUseError.invalidArguments("click_count must be a whole number from 1 through 100")
+    }
+    return integer
+}
