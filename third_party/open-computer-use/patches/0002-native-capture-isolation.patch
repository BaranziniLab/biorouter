@@ -0,0 +1,204 @@
+import AppKit
+import ApplicationServices
+import Foundation
+
+struct AccessibilityScrollObservation: Equatable {
+    let frames: [CGRect]
+    let values: [Double]
+    let reachedBoundary: Bool
+
+    init(frames: [CGRect], values: [Double], reachedBoundary: Bool = false) {
+        self.frames = frames
+        self.values = values
+        self.reachedBoundary = reachedBoundary
+    }
+}
+
+struct AccessibilityScrollProbe {
+    let elements: [AXUIElement]
+    let scrollBars: [AXUIElement]
+    let boundaryScrollBar: AXUIElement?
+    let direction: String
+
+    init(target: AXUIElement, direction: String) throws {
+        let vertical = direction == "up" || direction == "down"
+        let barAttribute = vertical ? kAXVerticalScrollBarAttribute : kAXHorizontalScrollBarAttribute
+        let directBar = Self.elementAttribute(target, barAttribute)
+        let targetWindow = Self.elementAttribute(target, kAXWindowAttribute)
+        var targetPID: pid_t = 0
+        AXUIElementGetPid(target, &targetPID)
+        var bars: [AXUIElement] = []
+        var ancestor: AXUIElement? = target
+        for _ in 0..<4 {
+            try ComputerUseCancellation.check()
+            guard let element = ancestor else { break }
+            var owner: pid_t = 0
+            guard AXUIElementGetPid(element, &owner) == .success, owner == targetPID else { break }
+            if let targetWindow, CFEqual(element, targetWindow) { break }
+            if let targetWindow {
+                guard let window = Self.elementAttribute(element, kAXWindowAttribute), CFEqual(window, targetWindow) else { break }
+            }
+            if let bar = Self.elementAttribute(element, barAttribute) { bars.append(bar); break }
+            guard targetWindow != nil else { break }
+            ancestor = Self.elementAttribute(element, kAXParentAttribute)
+        }
+        var queue: [(AXUIElement, Int)] = [(target, 0)]
+        var probes: [AXUIElement] = []
+        var visited = 0
+        while !queue.isEmpty, visited < 64, probes.count < 12 {
+            try ComputerUseCancellation.check()
+            let (element, depth) = queue.removeFirst()
+            visited += 1
+            if depth > 0, let frame = resolveLocalFrame(of: element, windowBounds: nil), !frame.isEmpty {
+                probes.append(element)
+            }
+            if Self.stringAttribute(element, kAXRoleAttribute) == kAXScrollBarRole as String {
+                let orientation = Self.stringAttribute(element, kAXOrientationAttribute)
+                if orientation == (vertical ? kAXVerticalOrientationValue : kAXHorizontalOrientationValue) {
+                    bars.append(element)
+                }
+            }
+            if depth < 5 {
+                var value: CFTypeRef?
+                if AXUIElementCopyAttributeValue(element, kAXChildrenAttribute as CFString, &value) == .success,
+                   let children = value as? [AXUIElement] {
+                    queue.append(contentsOf: children.prefix(24).map { ($0, depth + 1) })
+                }
+            }
+        }
+        elements = probes
+        scrollBars = bars
+        if let directBar, let targetWindow {
+            var owner: pid_t = 0
+            boundaryScrollBar = AXUIElementGetPid(directBar, &owner) == .success
+                && owner == targetPID && focusedElementBelongsToWindow(directBar, window: targetWindow) ? directBar : nil
+        } else {
+            boundaryScrollBar = nil
+        }
+        self.direction = direction
+    }
+
+    func read() throws -> AccessibilityScrollObservation {
+        let frames = try elements.map { element in
+            try ComputerUseCancellation.check()
+            guard let frame = resolveLocalFrame(of: element, windowBounds: nil) else {
+                throw ComputerUseError.stateUnavailable("Scroll observation became unavailable. Outcome may be partial; inspect before retrying.")
+            }
+            return frame
+        }
+        let values = try scrollBars.map { element in
+            try ComputerUseCancellation.check()
+            var value: CFTypeRef?
+            guard AXUIElementCopyAttributeValue(element, kAXValueAttribute as CFString, &value) == .success,
+                  let number = value as? NSNumber, number.doubleValue.isFinite else {
+                throw ComputerUseError.stateUnavailable("Scroll bar observation became unavailable. Outcome may be partial; inspect before retrying.")
+            }
+            return number.doubleValue
+        }
+        var reachedBoundary = false
+        if let bar = boundaryScrollBar,
+           let value = Self.numberAttribute(bar, kAXValueAttribute),
+           let minimum = Self.numberAttribute(bar, kAXMinValueAttribute),
+           let maximum = Self.numberAttribute(bar, kAXMaxValueAttribute) {
+            reachedBoundary = scrollValueAtBoundary(value: value, minimum: minimum, maximum: maximum, direction: direction)
+        }
