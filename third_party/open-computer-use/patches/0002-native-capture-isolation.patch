--- /dev/null
+++ b/packages/OpenComputerUseKit/Sources/OpenComputerUseKit/ComputerUseCancellation.swift
@@ -0,0 +1,31 @@
+import Foundation
+
+/// The app agent sets this on the serial operation thread; no other connection can
+/// cancel its owner. Cancellation never replays an input already sent to the OS.
+public enum ComputerUseCancellation {
+    private static let key = "org.biorouter.computer-use.cancellation"
+    private final class Probe {
+        let cancelled: () -> Bool
+        init(_ cancelled: @escaping () -> Bool) { self.cancelled = cancelled }
+    }
+
+    public static func withProbe<T>(_ cancelled: @escaping () -> Bool, _ body: () throws -> T) rethrows -> T {
+        let previous = Thread.current.threadDictionary[key]
+        Thread.current.threadDictionary[key] = Probe(cancelled)
+        defer {
+            if let previous { Thread.current.threadDictionary[key] = previous }
+            else { Thread.current.threadDictionary.removeObject(forKey: key) }
+        }
+        return try body()
+    }
+
+    public static var isCancelled: Bool {
+        (Thread.current.threadDictionary[key] as? Probe)?.cancelled() ?? false
+    }
+
+    public static func check() throws {
+        if isCancelled {
+            throw ComputerUseError.message("computer_use_cancelled: owner disconnected; already delivered input has an uncertain outcome. Inspect before retrying.")
+        }
+    }
+}
