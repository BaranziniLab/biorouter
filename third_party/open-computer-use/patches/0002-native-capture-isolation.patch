+func TestWindowsScrollViewportFractionsAndNoReplay(t *testing.T) {
+	if runtime.GOOS != "windows" {
+		t.Skip("PowerShell viewport contract runs on Windows")
+	}
+	script := `$ErrorActionPreference = "Stop"
+Add-Type -TypeDefinition @'
+public static class OCUWin32 {
+ public class Info { public int nMin=0,nMax=2000,nPos=0; public uint nPage=200; }
+ public static int Position,Posts,DelayReads; public static int Pending=-1; public static bool Noop,Large;
+ public static bool IsChild(System.IntPtr root,System.IntPtr child) { return root.ToInt64()==100 && child.ToInt64()==200; }
+ public static uint GetWindowThreadProcessId(System.IntPtr window,out uint processId) { processId=42; return 1; }
+ public static Info ReadScrollInfo(System.IntPtr window,int axis) { if (Pending >= 0 && DelayReads-- <= 0) { Position=Pending; Pending=-1; } return new Info { nPos=Position, nMax=Large ? 200000 : 2000, nPage=Large ? 1000u : 200u }; }
+ public static bool PostMessage(System.IntPtr window,uint message,System.IntPtr w,System.IntPtr l) {
+  Posts++; if (!Noop) { int requested=(int)((w.ToInt64() >> 16) & 65535); if (DelayReads>0) Pending=requested; else Position=requested; } return true;
+ }
+}
+namespace Windows.Automation {
+ public class ScrollPattern { public static object Pattern = new object(); }
+ public class TreeWalker { public static object ControlViewWalker; }
+}
+'@
+$walker = [pscustomobject]@{}
+$walker | Add-Member ScriptMethod GetParent { param($node) return $node.Parent }
+[Windows.Automation.TreeWalker]::ControlViewWalker = $walker
+function Start-Sleep { param($Milliseconds) }
+function New-Pattern {
+ $pattern = [pscustomobject]@{ Current = [pscustomobject]@{ HorizontallyScrollable=$true; VerticallyScrollable=$true; HorizontalScrollPercent=0.0; VerticalScrollPercent=0.0; HorizontalViewSize=20.0; VerticalViewSize=10.0 }; Calls=0; Fail=$false; Noop=$false }
+ $pattern | Add-Member ScriptMethod SetScrollPercent { param($horizontal,$vertical)
+  $this.Calls++
+  if ($this.Fail) { throw 'ambiguous provider failure' }
+  if (-not $this.Noop) {
+   if ($horizontal -ge 0) { $this.Current.HorizontalScrollPercent=$horizontal }
+   if ($vertical -ge 0) { $this.Current.VerticalScrollPercent=$vertical }
+  }
+ }
+ return $pattern
+}
+function New-Node($pattern,$parent,[int]$processId=42,[int]$hwnd=0) {
+ $node=[pscustomobject]@{Pattern=$pattern; Parent=$parent; Current=[pscustomobject]@{ProcessId=$processId; NativeWindowHandle=$hwnd}}
+ $node | Add-Member ScriptMethod GetCurrentPattern { param($id) return $this.Pattern }
+ return $node
+}
+`
+	for _, name := range []string{"Get-CurrentPatternOrNull", "Assert-NativeNumber", "Assert-ScrollPages", "Test-ScrollWindow", "Get-ScrollPattern", "Invoke-Scroll", "Invoke-NativeScroll"} {
+		start := strings.Index(windowsRuntimeScript, "function "+name+"(")
+		if start < 0 {
+			t.Fatalf("missing %s", name)
+		}
+		source := windowsRuntimeScript[start:]
+		if end := strings.Index(source[1:], "\nfunction "); end >= 0 {
+			source = source[:end+1]
+		}
+		script += source + "\n"
+	}
+	script += `
+foreach ($name in @('pages','click_count')) {
+ foreach ($value in @($null,$true,'2',0,-1,101,[double]::NaN,[double]::PositiveInfinity)) {
+  $failed=$false;try {Assert-NativeNumber $value $name}catch{$failed=$true}
+  if (-not $failed) {throw "Native $name accepted invalid value"}
+ }
+}
+Assert-NativeNumber 0.5 'pages'
+Assert-NativeNumber 2 'click_count'
+$failed=$false;try {Assert-NativeNumber 1.5 'click_count'}catch{$failed=$true}
+if (-not $failed) {throw 'Native click_count accepted fractional value'}
+$process=[pscustomobject]@{Id=42;MainWindowHandle=100}
+$outer=New-Pattern; $inner=New-Pattern
+$root=New-Node $outer $null 42 100
+$parent=New-Node $inner $root
+$leaf=New-Node $null $parent
+$result=Invoke-Scroll $leaf 'right' 0.5 $process
+if ($inner.Calls -ne 1 -or $outer.Calls -ne 0 -or $inner.Current.HorizontalScrollPercent -ne 12.5 -or $inner.Current.VerticalScrollPercent -ne 0 -or $result -notmatch 'observed 0.5') {throw 'Fractional horizontal viewport mapping failed'}
+Invoke-Scroll $leaf 'down' 2.5 $process | Out-Null
+if ($inner.Calls -ne 2 -or [math]::Abs($inner.Current.VerticalScrollPercent - 27.7777777778) -gt 0.0001 -or $inner.Current.HorizontalScrollPercent -ne 12.5) {throw 'Multi-page vertical viewport mapping failed'}
+Invoke-Scroll $leaf 'up' 100 $process | Out-Null
+if ($inner.Current.VerticalScrollPercent -ne 0) {throw 'Boundary clamp failed'}
+$before=$inner.Calls
+foreach ($pages in @(0,-1,101,[double]::NaN,[double]::PositiveInfinity)) {
+ $failed=$false;try {Invoke-Scroll $leaf 'down' $pages $process | Out-Null}catch{$failed=$true}
+ if (-not $failed -or $inner.Calls -ne $before) {throw 'Invalid pages mutated provider'}
+}
+$inner.Fail=$true
+$failed=$false;try {Invoke-Scroll $leaf 'down' 1 $process | Out-Null}catch{$failed=$true}
+if (-not $failed -or $inner.Calls -ne $before+1 -or $outer.Calls -ne 0) {throw 'Ambiguous mutation replayed'}
+$inner.Fail=$false;$inner.Noop=$true
+$failed=$false;try {Invoke-Scroll $leaf 'down' 1 $process | Out-Null}catch{$failed=$true}
+if (-not $failed -or $inner.Calls -ne $before+2 -or $outer.Calls -ne 0) {throw 'No-op provider accepted or replayed'}
+$foreign=New-Node $outer $null 99 900
+if ($null -ne (Get-ScrollPattern (New-Node $null $foreign) $process $true)) {throw 'Crossed process boundary'}
+$root=New-Node $null (New-Node $outer $null 42 200) 42 100
+if ($null -ne (Get-ScrollPattern $root $process $true)) {throw 'Crossed root window boundary'}
+$nativeRoot=New-Node $null $null 42 100
+$nativeLeaf=New-Node $null $nativeRoot
+Invoke-NativeScroll $nativeLeaf 'down' 0.5 $process | Out-Null
+if ([OCUWin32]::Position -ne 100 -or [OCUWin32]::Posts -ne 1) {throw 'Native fractional viewport mapping failed'}
+Invoke-NativeScroll $nativeLeaf 'up' 0.5 $process | Out-Null
+if ([OCUWin32]::Position -ne 0) {throw 'Native reverse mapping failed'}
+Invoke-NativeScroll $nativeLeaf 'down' 2.5 $process | Out-Null
+if ([OCUWin32]::Position -ne 500) {throw 'Native multipage viewport mapping failed'}
+[OCUWin32]::Noop=$true
+$beforePosts=[OCUWin32]::Posts
+$failed=$false;try{Invoke-NativeScroll $nativeLeaf 'down' 0.5 $process | Out-Null}catch{$failed=$true}
+if (-not $failed -or [OCUWin32]::Posts -ne $beforePosts+1) {throw 'Native noop accepted or replayed'}
+$beforePosts=[OCUWin32]::Posts
+$failed=$false;try{Invoke-NativeScroll $nativeLeaf 'down' 0.005 $process | Out-Null}catch{$failed=$true}
+if (-not $failed -or [OCUWin32]::Posts -ne $beforePosts+1) {throw 'One-unit native noop accepted or replayed'}
+[OCUWin32]::Noop=$false;[OCUWin32]::DelayReads=3
+$beforePosts=[OCUWin32]::Posts
+Invoke-NativeScroll $nativeLeaf 'down' 0.005 $process | Out-Null
+if ([OCUWin32]::Position -ne 501 -or [OCUWin32]::Posts -ne $beforePosts+1 -or [OCUWin32]::Pending -ne -1) {throw 'Delayed one-unit readback accepted before actual movement'}
+[OCUWin32]::DelayReads=0
+[OCUWin32]::Noop=$false;[OCUWin32]::Large=$true
+$beforePosts=[OCUWin32]::Posts
+$failed=$false;try{Invoke-NativeScroll $nativeLeaf 'down' 100 $process | Out-Null}catch{$failed=$true}
+if (-not $failed -or [OCUWin32]::Posts -ne $beforePosts) {throw 'Native 16-bit coordinate overflow delivered input'}
+Write-Output 'viewport scroll contract passed'
+`
