+++ b/packages/OpenComputerUseKit/Tests/OpenComputerUseKitTests/ComputerUseNumericArgumentTests.swift
@@ -0,0 +1,65 @@
+import Foundation
+import XCTest
+@testable import OpenComputerUseKit
+
+final class ComputerUseNumericArgumentTests: XCTestCase {
+    func testProvidedInvalidNumericTypesDoNotSilentlyDefault() {
+        let dispatcher = ComputerUseToolDispatcher()
+        for value: Any in ["3", NSNull(), true, NSNumber(value: false), [1], ["value": 1]] {
+            let scroll = dispatcher.callToolAsResult(name: "scroll", arguments: [
+                "app": "missing-fixture", "element_index": "22", "direction": "down", "pages": value,
+            ])
+            XCTAssertTrue(scroll.isError)
+            XCTAssertTrue(scroll.primaryText?.contains("pages") == true, scroll.primaryText ?? "no text")
+            let click = dispatcher.callToolAsResult(name: "click", arguments: [
+                "app": "missing-fixture", "element_index": "22", "click_count": value,
+            ])
+            XCTAssertTrue(click.isError)
+            XCTAssertTrue(click.primaryText?.contains("click_count") == true, click.primaryText ?? "no text")
+        }
+    }
+    func testDefaultsApplyOnlyToAbsentFieldsAndValidNumbersPreserveValue() throws {
+        XCTAssertEqual(try scrollPagesArgument(in: [:]), 1)
+        XCTAssertEqual(try clickCountArgument(in: [:]), 1)
+        for value in [0.25, 1, 3, 100] {
+            XCTAssertEqual(try scrollPagesArgument(in: ["pages": value]), value)
+        }
+        for value in [1, 2, 3, 100] {
+            XCTAssertEqual(try clickCountArgument(in: ["click_count": value]), value)
+        }
+    }
+
+    func testHugeNonFiniteFractionalAndOutOfRangeCountsRejectBeforeService() {
+        let dispatcher = ComputerUseToolDispatcher()
+        for value in [Double.greatestFiniteMagnitude, Double(Int.max), Double.infinity, -Double.infinity, Double.nan, 0, -1, 101, 1.5] {
+            let result = dispatcher.callToolAsResult(name: "click", arguments: ["app": "missing-fixture", "element_index": "2", "click_count": value])
+            XCTAssertTrue(result.isError)
+            XCTAssertTrue(result.primaryText?.contains("click_count") == true)
+        }
+        for value in [Double.greatestFiniteMagnitude, Double.infinity, Double.nan, 0, -1, 101] {
+            let result = dispatcher.callToolAsResult(name: "scroll", arguments: ["app": "missing-fixture", "element_index": "2", "direction": "down", "pages": value])
+            XCTAssertTrue(result.isError)
+            XCTAssertTrue(result.primaryText?.contains("pages") == true)
+        }
+    }
+
+    func testJSONBooleansAndNullStayInvalidAfterDeserialization() throws {
+        for json in ["{\"pages\":true,\"click_count\":true}", "{\"pages\":null,\"click_count\":null}"] {
+            let arguments = try XCTUnwrap(JSONSerialization.jsonObject(with: Data(json.utf8)) as? [String: Any])
+            XCTAssertThrowsError(try scrollPagesArgument(in: arguments))
+            XCTAssertThrowsError(try clickCountArgument(in: arguments))
+        }
+    }
+
+    func testSchemaAdvertisesNumericRuntimeBounds() throws {
+        let click = try XCTUnwrap(ToolDefinitions.all.first { $0.name == "click" })
+        let scroll = try XCTUnwrap(ToolDefinitions.all.first { $0.name == "scroll" })
+        let clickProperties = try XCTUnwrap(click.inputSchema["properties"] as? [String: [String: Any]])
+        let scrollProperties = try XCTUnwrap(scroll.inputSchema["properties"] as? [String: [String: Any]])
+        XCTAssertEqual(clickProperties["click_count"]?["minimum"] as? Int, 1)
+        XCTAssertEqual(clickProperties["click_count"]?["maximum"] as? Int, 100)
+        XCTAssertEqual(scrollProperties["pages"]?["exclusiveMinimum"] as? Int, 0)
+        XCTAssertEqual(scrollProperties["pages"]?["maximum"] as? Int, 100)
+    }
+
+}
diff --git a/packages/OpenComputerUseKit/Tests/OpenComputerUseKitTests/GlobalPointerTargetTests.swift b/packages/OpenComputerUseKit/Tests/OpenComputerUseKitTests/GlobalPointerTargetTests.swift
new file mode 100644
index 0000000..a5eff56
--- /dev/null
+++ b/packages/OpenComputerUseKit/Tests/OpenComputerUseKitTests/GlobalPointerTargetTests.swift
@@ -0,0 +1,126 @@
+import AppKit
+import XCTest
+@testable import OpenComputerUseKit
+
+final class GlobalPointerTargetTests: XCTestCase {
+    let bounds = CGRect(x: 204, y: 39, width: 1570, height: 940)
+
+    func testCapturedWindowIdentityAndGeometryMustRemainValid() {
+        let original: [String: Any] = [
+            kCGWindowNumber as String: NSNumber(value: 42),
+            kCGWindowOwnerPID as String: NSNumber(value: 123),
+            kCGWindowIsOnscreen as String: true,
+            kCGWindowBounds as String: bounds.dictionaryRepresentation,
+        ]
+        XCTAssertTrue(globalPointerWindowMatches([original], windowID: 42, pid: 123, bounds: bounds))
+        XCTAssertFalse(globalPointerWindowMatches([], windowID: 42, pid: 123, bounds: bounds))
+        for (key, value) in [
+            (kCGWindowNumber as String, NSNumber(value: 43) as Any),
+            (kCGWindowOwnerPID as String, NSNumber(value: 124) as Any),
+            (kCGWindowIsOnscreen as String, false as Any),
+            (kCGWindowBounds as String, bounds.offsetBy(dx: 20, dy: 0).dictionaryRepresentation as Any),
+            (kCGWindowBounds as String, CGRect(x: 204, y: 39, width: 1500, height: 940).dictionaryRepresentation as Any),
+        ] {
+            var changed = original
+            changed[key] = value
+            XCTAssertFalse(globalPointerWindowMatches([changed], windowID: 42, pid: 123, bounds: bounds), key)
+        }
+    }
+
+    func testCaptureRejectsAmbiguousAndMissingGeometry() {
+        let first = WindowCaptureCandidate(windowID: 1, layer: 0, bounds: bounds, title: "Shared", area: 100, frontToBackIndex: 0)
+        let second = WindowCaptureCandidate(windowID: 2, layer: 0, bounds: bounds, title: "Shared", area: 100, frontToBackIndex: 1)
+        XCTAssertNil(preferredWindowCaptureCandidate([first, second], titleHint: "Shared", boundsHint: bounds))
+        XCTAssertNil(preferredWindowCaptureCandidate([first], titleHint: "Shared", boundsHint: nil))
+        XCTAssertNil(preferredWindowCaptureCandidate([first], titleHint: "Shared", boundsHint: bounds.offsetBy(dx: 50, dy: 0)))
+    }
+
+    func testPreparationActivatesThenRaisesAndRevalidatesBeforeDelivery() throws {
+        var calls: [String] = []
+        try prepareGlobalPointerTarget(
+            validate: { calls.append("validate") },
+            activate: { calls.append("activate"); return true },
+            raise: { calls.append("raise captured"); return true },
+            isReady: { calls.append("ready"); return true },
+            pause: { XCTFail("Already ready") }
+        )
+        calls.append("deliver")
+        XCTAssertEqual(calls, ["validate", "activate", "raise captured", "validate", "ready", "deliver"])
+    }
+
+    func testCancellationDuringAXChecksPreventsFollowingSideEffects() {
+        for stage in ["validate", "ready"] {
+            var cancelled = false
+            var activated = false
+            var delivered = false
+            XCTAssertThrowsError(try {
+                try prepareGlobalPointerTarget(
+                    validate: { if stage == "validate" { cancelled = true } },
+                    activate: { activated = true; return true },
+                    raise: { true },
+                    isReady: { cancelled = true; return true },
+                    pause: { XCTFail("Cancellation must exit without waiting") },
+                    checkCancellation: {
+                        if cancelled { throw ComputerUseError.stateUnavailable("cancelled") }
+                    }
+                )
+                delivered = true
+            }(), stage)
+            XCTAssertEqual(activated, stage == "ready", stage)
+            XCTAssertFalse(delivered, stage)
+        }
+    }
+
+    func testFocusedElementOwnershipFiltersBeforeReadingSelectedText() {
+        struct Focus { let pid: pid_t; let window: Int; let selectedText: String }
+        for candidate in [
+            Focus(pid: 999, window: 42, selectedText: "foreign app"),
+            Focus(pid: 123, window: 43, selectedText: "other window"),
+            Focus(pid: 123, window: 42, selectedText: "target"),
+        ] {
+            var selectedTextReads = 0
+            let focused = ownedFocusedElement(candidate: candidate, appPID: 123,
+                readPID: { $0.pid }, belongsToWindow: { $0.window == 42 })
+            let selected = focused.map { value in
+                selectedTextReads += 1
+                return value.selectedText
+            }
+            let accepted = candidate.pid == 123 && candidate.window == 42
+            XCTAssertEqual(selectedTextReads, accepted ? 1 : 0)
+            XCTAssertEqual(selected, accepted ? "target" : nil)
+        }
+    }
+
+    func testFailedPreparationNeverReachesDelivery() {
+        for failure in ["stale", "activation", "raise", "geometry after raise", "timeout", "cancel"] {
+            var delivered = false
+            var validations = 0
+            var pauses = 0
+            var cancellationChecks = 0
+            XCTAssertThrowsError(try {
+                try prepareGlobalPointerTarget(
+                    validate: {
+                        validations += 1
+                        if failure == "stale" || (failure == "geometry after raise" && validations > 1) {
+                            throw ComputerUseError.stateUnavailable("changed")
+                        }
+                    },
+                    activate: { failure != "activation" },
+                    raise: { failure != "raise" },
+                    isReady: { failure != "timeout" },
+                    pause: { pauses += 1 },
+                    checkCancellation: {
+                        cancellationChecks += 1
+                        if failure == "cancel" && cancellationChecks > 1 {
+                            throw ComputerUseError.stateUnavailable("cancelled")
+                        }
+                    }
+                )
+                delivered = true
+            }(), failure)
+            XCTAssertFalse(delivered, failure)
+            XCTAssertLessThanOrEqual(pauses, 20)
+            if failure == "timeout" { XCTAssertEqual(pauses, 20) }
+        }
+    }
+}
