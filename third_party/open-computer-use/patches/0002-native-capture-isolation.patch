diff --git a/packages/OpenComputerUseKit/Sources/OpenComputerUseKit/ScreenCapture.swift b/packages/OpenComputerUseKit/Sources/OpenComputerUseKit/ScreenCapture.swift
new file mode 100644
index 0000000..006df0d
--- /dev/null
+++ b/packages/OpenComputerUseKit/Sources/OpenComputerUseKit/ScreenCapture.swift
@@ -0,0 +1,161 @@
+import AppKit
+import ApplicationServices
+import CoreGraphics
+import Foundation
+import ScreenCaptureKit
+
+struct ScreenCaptureRequest: Sendable {
+    let display: Int?
+    let windowTitle: String?
+    let listOnly: Bool
+
+    init(arguments: [String: Any]) throws {
+        for key in arguments.keys where !["display", "window_title", "list_only"].contains(key) {
+            throw ComputerUseError.invalidArguments("Unknown screen_capture argument: \(key)")
+        }
+        if let raw = arguments["display"] {
+            guard let number = raw as? NSNumber,
+                  CFGetTypeID(number) != CFBooleanGetTypeID(),
+                  number.doubleValue.isFinite, number.doubleValue >= 0,
+                  number.doubleValue <= Double(Int32.max),
+                  number.doubleValue.rounded(.towardZero) == number.doubleValue else {
+                throw ComputerUseError.invalidArguments("display must be a nonnegative integer")
+            }
+            display = number.intValue
+        } else { display = nil }
+        if let raw = arguments["window_title"] {
+            guard let title = raw as? String, !title.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else {
+                throw ComputerUseError.invalidArguments("window_title must be a nonempty string")
+            }
+            windowTitle = title
+        } else { windowTitle = nil }
+        if let raw = arguments["list_only"] {
+            guard let number = raw as? NSNumber, CFGetTypeID(number) == CFBooleanGetTypeID() else {
+                throw ComputerUseError.invalidArguments("list_only must be a boolean")
+            }
+            listOnly = number.boolValue
+        } else { listOnly = false }
+        guard display == nil || windowTitle == nil else {
+            throw ComputerUseError.invalidArguments("display and window_title are mutually exclusive")
+        }
+    }
+}
+
+struct NativePermissionTargets {
+    let accessibility: String
+    let screenRecording: String
+
+    init(helperBundleURL: URL = Bundle.main.bundleURL, helperName: String = PermissionSupport.currentBundleDisplayName()) {
+        accessibility = helperName
+        var screenRecordingOwner = helperName
+        var ancestor = helperBundleURL.standardizedFileURL.deletingLastPathComponent()
+        while ancestor.path != "/" {
+            if ancestor.pathExtension.lowercased() == "app", let bundle = Bundle(url: ancestor),
+               bundle.object(forInfoDictionaryKey: "CFBundlePackageType") as? String == "APPL" {
+                let names = [bundle.object(forInfoDictionaryKey: "CFBundleDisplayName") as? String,
+                             bundle.object(forInfoDictionaryKey: "CFBundleName") as? String]
+                screenRecordingOwner = names.compactMap { $0?.trimmingCharacters(in: .whitespacesAndNewlines) }
+                    .first { !$0.isEmpty } ?? ancestor.deletingPathExtension().lastPathComponent
+            }
+            ancestor.deleteLastPathComponent()
+        }
+        screenRecording = screenRecordingOwner
+    }
+
+    var setupMessage: String {
+        if accessibility == screenRecording {
+            return "Enable Accessibility and Screen Recording for \(accessibility) in System Settings."
+        }
+        return "Enable Accessibility for \(accessibility) and Screen Recording for \(screenRecording) in System Settings."
+    }
+
+    var captureDeniedMessage: String {
+        "screen_recording_permission_required: enable Screen Recording for \(screenRecording) in System Settings, then retry"
+    }
+}
+
+enum NativeScreenCapture {
+    static func capture(arguments: [String: Any]) throws -> ToolCallResult {
+        let request = try ScreenCaptureRequest(arguments: arguments)
+        try ComputerUseCancellation.check()
+        guard CGPreflightScreenCaptureAccess() else {
+            throw ComputerUseError.permissionDenied(NativePermissionTargets().captureDeniedMessage)
+        }
+        return try BlockingAsyncBridge.run(timeout: 15) {
+            try Task.checkCancellation()
+            let content = try await SCShareableContent.excludingDesktopWindows(false, onScreenWindowsOnly: true)
+            let displays = content.displays.sorted { $0.displayID < $1.displayID }
+            let windows = content.windows.filter { $0.windowLayer == 0 && !$0.frame.isEmpty }
+                .sorted { $0.windowID < $1.windowID }
+            func bounds(_ rect: CGRect) -> [String: Double] {
+                ["x": rect.origin.x, "y": rect.origin.y, "width": rect.width, "height": rect.height]
+            }
+            let displayMetadata: [[String: Any]] = displays.enumerated().map { index, display in
+                ["index": index, "id": display.displayID, "primary": display.displayID == CGMainDisplayID(),
+                 "bounds": bounds(display.frame), "pixel_width": CGDisplayPixelsWide(display.displayID),
+                 "pixel_height": CGDisplayPixelsHigh(display.displayID)]
+            }
+            let windowMetadata: [[String: Any]] = windows.map { window in
+                ["id": window.windowID, "title": window.title ?? "", "bounds": bounds(window.frame),
+                 "app": window.owningApplication?.applicationName ?? "", "pid": window.owningApplication?.processID ?? 0]
+            }
+            var metadata: [String: Any] = ["displays": displayMetadata, "windows": windowMetadata,
+                                          "coordinate_space": "desktop logical points"]
+            func text(_ metadata: [String: Any]) throws -> String {
+                String(decoding: try JSONSerialization.data(withJSONObject: metadata, options: [.sortedKeys]), as: UTF8.self)
+            }
+            if request.listOnly { return .text(try text(metadata)) }
+            let filter: SCContentFilter
+            let configuration = SCStreamConfiguration()
+            configuration.showsCursor = false
+            configuration.ignoreShadowsSingleWindow = true
+            configuration.scalesToFit = false
+            if let title = request.windowTitle {
+                let matches = windows.enumerated().filter { ($0.element.title ?? "").localizedCaseInsensitiveContains(title) }
+                guard matches.count == 1, let match = matches.first else {
+                    throw ComputerUseError.message("window_title must match exactly one window; found \(matches.count)")
+                }
+                filter = SCContentFilter(desktopIndependentWindow: match.element)
+                metadata["target"] = windowMetadata[match.offset]
+                configuration.width = max(1, Int(ceil(filter.contentRect.width * CGFloat(filter.pointPixelScale))))
+                configuration.height = max(1, Int(ceil(filter.contentRect.height * CGFloat(filter.pointPixelScale))))
+            } else {
+                let index = request.display ?? displays.firstIndex(where: { $0.displayID == CGMainDisplayID() }) ?? 0
+                guard displays.indices.contains(index) else {
+                    throw ComputerUseError.message("display index out of range; use list_only")
+                }
+                let display = displays[index]
+                filter = SCContentFilter(display: display, excludingWindows: [])
+                metadata["target"] = displayMetadata[index]
+                configuration.width = max(1, CGDisplayPixelsWide(display.displayID))
+                configuration.height = max(1, CGDisplayPixelsHigh(display.displayID))
+            }
+            try Task.checkCancellation()
+            let image = try await SCScreenshotManager.captureImage(contentFilter: filter, configuration: configuration)
+            try Task.checkCancellation()
+            guard let png = NSBitmapImageRep(cgImage: image).representation(using: .png, properties: [:]) else {
+                throw ComputerUseError.message("Native capture PNG encoding failed")
+            }
+            metadata["pixel_width"] = image.width
+            metadata["pixel_height"] = image.height
+            return ToolCallResult(content: [.text(try text(metadata)), .pngImage(png)])
+        }
+    }
+}
+
+public func nativeRuntimeDiagnosticsJSON() throws -> String {
+    var displayCount: UInt32 = 0
+    let hasDisplays = CGGetActiveDisplayList(0, nil, &displayCount) == .success && displayCount > 0
+    let session = CGSessionCopyCurrentDictionary() as? [String: Any]
+    let desktop = hasDisplays && (session?[kCGSessionOnConsoleKey as String] as? Bool == true)
+    let accessibility = AXIsProcessTrusted()
+    let screenRecording = CGPreflightScreenCaptureAccess()
+    let state = !desktop ? "desktop_unavailable" : (!accessibility || !screenRecording ? "os_permission_required" : "ready")
+    let message = !desktop ? "Run BioRouter in the signed-in user's desktop session." :
+        (!accessibility || !screenRecording ? NativePermissionTargets().setupMessage : "Native desktop access is ready.")
+    let data = try JSONSerialization.data(withJSONObject: [
+        "state": state, "desktop_available": desktop, "accessibility": accessibility,
+        "screen_recording": screenRecording, "capture_available": desktop && screenRecording, "message": message,
+    ], options: [.sortedKeys])
+    return String(decoding: data, as: UTF8.self)
+}
