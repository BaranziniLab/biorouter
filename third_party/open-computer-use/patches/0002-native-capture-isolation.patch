+			WindowBounds: &origin,
+			Elements:     []elementRecord{{Index: 1, Name: "FixtureInput", Frame: &frame{X: 28, Y: 61, Width: 400, Height: 20}}},
+		}
+		s.rememberSnapshot("fixture", snapshot)
+		called := false
+		s.runNative = func(request psRequest) (*psResponse, error) {
+			called = true
+			payload, err := json.Marshal(request)
+			if err != nil {
+				t.Fatal(err)
