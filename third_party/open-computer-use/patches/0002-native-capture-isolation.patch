-    private static func scrollWheelDelta(for pages: Double) -> Int32 {
-        let rawValue = (12.0 * pages).rounded(.toNearestOrAwayFromZero)
-        let clamped = min(Double(Int32.max), max(1, rawValue))
-        return Int32(clamped)
+func scrollPixelDeltas(direction: String, pixels: Double) -> (vertical: Int32, horizontal: Int32) {
+    let magnitude = Int32(min(Double(Int32.max), max(1, pixels.rounded(.toNearestOrAwayFromZero))))
+    switch direction {
+    case "up": return (magnitude, 0)
+    case "down": return (-magnitude, 0)
+    case "left": return (0, magnitude)
+    case "right": return (0, -magnitude)
+    default: return (0, 0)
     }
 }
