+				t.Fatalf("scroll lost observed window origin on native wire: %s", payload)
+			}
+			if wire.Element == nil || wire.Element.Frame == nil {
+				t.Fatalf("scroll lost target frame on native wire: %s", payload)
+			}
+			pointX := wire.WindowBounds.X + wire.Element.Frame.X + wire.Element.Frame.Width/2
+			pointY := wire.WindowBounds.Y + wire.Element.Frame.Y + wire.Element.Frame.Height/2
