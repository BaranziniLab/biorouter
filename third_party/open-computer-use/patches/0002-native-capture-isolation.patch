diff --git a/packages/OpenComputerUseKit/Tests/OpenComputerUseKitTests/AccessibilityScrollProgressTests.swift b/packages/OpenComputerUseKit/Tests/OpenComputerUseKitTests/AccessibilityScrollProgressTests.swift
new file mode 100644
index 0000000..c8dfc43
--- /dev/null
+++ b/packages/OpenComputerUseKit/Tests/OpenComputerUseKitTests/AccessibilityScrollProgressTests.swift
@@ -0,0 +1,135 @@
+import AppKit
+import XCTest
+@testable import OpenComputerUseKit
+
+final class AccessibilityScrollProgressTests: XCTestCase {
+    func testMultiplePagesWaitForProgressAndSettleBetweenActions() throws {
+        var pages = 0
+        var ticks = 100
+        var position = 0
+        try performObservedPageScroll(pages: 3, read: {
+            if ticks == 2 { position += 100 }
+            return position
+        }, performPage: {
+            XCTAssertGreaterThanOrEqual(ticks, 6, "A second action during animation would coalesce")
+            pages += 1
+            ticks = 0
+        }, pause: { ticks += 1 })
+        XCTAssertEqual(pages, 3)
+        XCTAssertEqual(position, 300)
+    }
+
+    func testFixedFrameScrollControlsUseChangingScrollBarValues() throws {
+        var pages = 0
+        let fixed = CGRect(x: 20, y: 40, width: 400, height: 300)
+        try performObservedPageScroll(pages: 3, read: {
+            AccessibilityScrollObservation(frames: [fixed], values: [Double(pages) / 10])
+        }, performPage: { pages += 1 }, pause: {})
+        XCTAssertEqual(pages, 3)
+    }
+
+    func testScrollPageBoundsRejectOverflowBeforeInput() {
+        for pages in [Double.greatestFiniteMagnitude, Double(Int.max), 101, Double.infinity, Double.nan, 0, -1] {
+            XCTAssertThrowsError(try validateScrollPages(pages))
+        }
+        for pages in [0.5, 1, 100] { XCTAssertNoThrow(try validateScrollPages(pages)) }
+    }
+
+    func testBoundaryDirectionAndRangeMustBeExplicit() {
+        for direction in ["up", "left"] {
+            XCTAssertTrue(scrollValueAtBoundary(value: 0, minimum: 0, maximum: 1, direction: direction))
+            XCTAssertFalse(scrollValueAtBoundary(value: 1, minimum: 0, maximum: 1, direction: direction))
+        }
+        for direction in ["down", "right"] {
+            XCTAssertTrue(scrollValueAtBoundary(value: 1, minimum: 0, maximum: 1, direction: direction))
+            XCTAssertFalse(scrollValueAtBoundary(value: 0, minimum: 0, maximum: 1, direction: direction))
+        }
+        XCTAssertFalse(scrollValueAtBoundary(value: 0.5, minimum: 0, maximum: 1, direction: "down"))
+        XCTAssertFalse(scrollValueAtBoundary(value: 0, minimum: 0, maximum: 0, direction: "up"))
+        XCTAssertFalse(scrollValueAtBoundary(value: .nan, minimum: 0, maximum: 1, direction: "up"))
+        XCTAssertFalse(scrollValueAtBoundary(value: 2, minimum: 0, maximum: 1, direction: "down"))
+    }
+
+    func testKnownBoundaryReturnsActualPagesWithoutOvershoot() throws {
+        var pages = 0
+        let outcome = try performObservedPageScroll(pages: 5, read: { min(pages, 2) }, performPage: {
+            pages += 1
+        }, pause: {}, isAtBoundary: { $0 == 2 })
+        XCTAssertEqual(outcome, PageScrollOutcome(verifiedPages: 2, reachedBoundary: true))
+        XCTAssertEqual(pages, 2)
+        let alreadyAtEdge = try performObservedPageScroll(pages: 5, read: { 2 }, performPage: {
+            XCTFail("Already at edge")
+        }, pause: {}, isAtBoundary: { $0 == 2 })
+        XCTAssertEqual(alreadyAtEdge, PageScrollOutcome(verifiedPages: 0, reachedBoundary: true))
+    }
+
+    func testFallbackPagesBecomeSeparateViewportPixelEvents() throws {
+        let geometry = try scrollPageGeometry(elementFrame: CGRect(x: 0, y: 143, width: 1570, height: 797),
+            windowBounds: CGRect(x: 204, y: 39, width: 1570, height: 940), direction: "down")
+        XCTAssertEqual(geometry.extent, 797)
+        XCTAssertEqual(geometry.point, CGPoint(x: 989, y: 580.5))
+        let chunks = try scrollPageChunks(3)
+        XCTAssertEqual(chunks, [1, 1, 1])
+        var sent = 0
+        var deltas: [Int64] = []
+        try performObservedPageScroll(pages: chunks.count, read: { sent }, performPage: {
+            let event = try InputSimulation.scrollEvent(at: geometry.point, direction: "down", pixels: geometry.extent * chunks[sent])
+            deltas.append(event.getIntegerValueField(.scrollWheelEventPointDeltaAxis1))
+            XCTAssertEqual(event.getIntegerValueField(.scrollWheelEventPointDeltaAxis2), 0)
+            XCTAssertEqual(event.location, geometry.point)
+            sent += 1
+        }, pause: {})
+        XCTAssertEqual(deltas, [-797, -797, -797])
+        XCTAssertEqual(try scrollPageChunks(2.5), [1, 1, 0.5])
+        XCTAssertEqual(try scrollPageChunks(0.25), [0.25])
+    }
+
+    func testFallbackGeometryClipsOversizedContentAndSupportsHorizontalPages() throws {
+        let window = CGRect(x: 200, y: 40, width: 800, height: 600)
+        let frame = CGRect(x: 20, y: 100, width: 2000, height: 3000)
+        XCTAssertEqual(try scrollPageGeometry(elementFrame: frame, windowBounds: window, direction: "down").extent, 500)
+        XCTAssertEqual(try scrollPageGeometry(elementFrame: frame, windowBounds: window, direction: "right").extent, 780)
+        let event = try InputSimulation.scrollEvent(at: .zero, direction: "right", pixels: 390)
+        XCTAssertEqual(event.getIntegerValueField(.scrollWheelEventPointDeltaAxis2), -390)
+        XCTAssertEqual(event.getIntegerValueField(.scrollWheelEventPointDeltaAxis1), 0)
+        XCTAssertThrowsError(try scrollPageGeometry(elementFrame: CGRect(x: 900, y: 0, width: 100, height: 100), windowBounds: window, direction: "down"))
+        XCTAssertThrowsError(try InputSimulation.scrollEvent(at: .zero, direction: "down", pixels: .nan))
+    }
+
+    func testNoProgressStopsBeforeRemainingActions() {
+        var pages = 0
+        XCTAssertThrowsError(try performObservedPageScroll(pages: 5, read: { 21 }, performPage: {
+            pages += 1
+        }, pause: {})) { error in
+            XCTAssertTrue(String(describing: error).contains("0 scroll steps were verified"))
+        }
+        XCTAssertEqual(pages, 1)
+    }
+
+    func testPartialProgressReportsActualCompletedPages() {
+        var pages = 0
+        XCTAssertThrowsError(try performObservedPageScroll(pages: 3, read: { pages == 0 ? 0 : 100 }, performPage: {
+            pages += 1
+        }, pause: {})) { error in
+            XCTAssertTrue(String(describing: error).contains("1 scroll steps were verified"))
+        }
+        XCTAssertEqual(pages, 2)
+    }
+
+    func testCancelledOrUnreadableObservationNeverSendsAnotherPage() {
+        for failure in ["cancel", "stale"] {
+            var pages = 0
+            var cancelled = false
+            XCTAssertThrowsError(try performObservedPageScroll(pages: 3, read: {
+                if pages > 0 {
+                    if failure == "stale" { throw ComputerUseError.stateUnavailable("stale") }
+                    cancelled = true
+                }
+                return pages
+            }, performPage: { pages += 1 }, pause: {}, checkCancellation: {
+                if cancelled { throw ComputerUseError.stateUnavailable("cancelled") }
+            }))
+            XCTAssertEqual(pages, 1)
+        }
+    }
+}
