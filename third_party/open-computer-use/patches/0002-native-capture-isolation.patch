+        guard AXUIElementCopyAttributeValue(element, attribute as CFString, &value) == .success else { return nil }
+        return value as? String
+    }
+}
+
+struct PageScrollOutcome: Equatable {
+    let verifiedPages: Int
+    let reachedBoundary: Bool
+}
+
+func scrollValueAtBoundary(value: Double, minimum: Double, maximum: Double, direction: String) -> Bool {
+    guard value.isFinite, minimum.isFinite, maximum.isFinite, minimum < maximum,
+          value >= minimum, value <= maximum else { return false }
+    switch direction {
+    case "up", "left": return value == minimum
+    case "down", "right": return value == maximum
+    default: return false
+    }
+}
+
+@discardableResult
+func performObservedPageScroll<Observation: Equatable>(
+    pages: Int,
+    read: () throws -> Observation,
+    performPage: () throws -> Void,
+    pause: () -> Void,
+    isAtBoundary: (Observation) -> Bool = { _ in false },
+    checkCancellation: () throws -> Void = ComputerUseCancellation.check
+) throws -> PageScrollOutcome {
+    var previous = try read()
+    try checkCancellation()
+    if isAtBoundary(previous) { return PageScrollOutcome(verifiedPages: 0, reachedBoundary: true) }
+    for completed in 0..<pages {
+        try checkCancellation()
+        try performPage()
+        var changed = false
+        var stableSamples = 0
+        var settled = false
+        let deadline = ProcessInfo.processInfo.systemUptime + 2
+        for sample in 0..<40 {
+            try checkCancellation()
+            pause()
+            if ProcessInfo.processInfo.systemUptime >= deadline { break }
+            let current = try read()
+            try checkCancellation()
+            if current != previous {
+                changed = true
+                stableSamples = 0
+            } else {
+                stableSamples += 1
+            }
+            previous = current
+            if changed, stableSamples >= 4, sample >= 5 {
+                settled = true
+                break
+            }
+        }
+        guard settled else {
+            throw ComputerUseError.stateUnavailable("Scroll progress could not be confirmed after scroll step \(completed + 1) of \(pages); \(completed) scroll steps were verified. The target may be at a boundary or still moving. No remaining scroll steps were sent; inspect before retrying.")
+        }
+        if isAtBoundary(previous) { return PageScrollOutcome(verifiedPages: completed + 1, reachedBoundary: true) }
+    }
+    return PageScrollOutcome(verifiedPages: pages, reachedBoundary: false)
+}
+
+func scrollPageChunks(_ pages: Double) throws -> [Double] {
+    try validateScrollPages(pages)
+    let whole = Int(pages.rounded(.down))
+    let remainder = pages - Double(whole)
+    return Array(repeating: 1, count: whole) + (remainder > 0 ? [remainder] : [])
+}
+
+func scrollPageGeometry(elementFrame: CGRect, windowBounds: CGRect, direction: String) throws -> (point: CGPoint, extent: Double) {
+    let visible = elementFrame.intersection(CGRect(origin: .zero, size: windowBounds.size))
+    let extent = direction == "up" || direction == "down" ? visible.height : visible.width
+    guard !visible.isNull, !visible.isEmpty, extent.isFinite, extent > 0 else {
+        throw ComputerUseError.stateUnavailable("The scroll target has no visible viewport. Run get_app_state again.")
+    }
+    return (CGPoint(x: windowBounds.minX + visible.midX, y: windowBounds.minY + visible.midY), Double(extent))
+}
