@@ -0,0 +1,66 @@
+import AppKit
+import XCTest
+@testable import OpenComputerUseKit
+
+final class AccessibilityValueReadbackTests: XCTestCase {
+    func testWritesOnceAndWaitsForRequestedValue() throws {
+        var writes = 0
+        var reads = 0
+        try writeAccessibilityValueAndVerify(expected: NSNumber(value: 60), write: {
+            writes += 1; return .success
+        }, read: {
+            reads += 1
+            return NSNumber(value: reads < 3 ? 21 : 60)
+        }, pause: {})
+        XCTAssertEqual(writes, 1)
+        XCTAssertEqual(reads, 3)
+    }
+
+    func testAcknowledgedNoOpNeverReportsSuccessOrReplays() {
+        var writes = 0
+        var reads = 0
+        XCTAssertThrowsError(try writeAccessibilityValueAndVerify(expected: NSNumber(value: 60), write: {
+            writes += 1; return .success
+        }, read: {
+            reads += 1; return NSNumber(value: 21)
+        }, pause: {}))
+        XCTAssertEqual(writes, 1)
+        XCTAssertEqual(reads, 20)
+    }
+
+    func testStaleOrUnreadableTargetDoesNotReplay() {
+        for error in [AXError.invalidUIElement, .cannotComplete, .attributeUnsupported] {
+            var writes = 0
+            var reads = 0
+            XCTAssertThrowsError(try writeAccessibilityValueAndVerify(expected: "requested" as CFString, write: {
+                writes += 1; return .success
+            }, read: {
+                reads += 1
+                throw ComputerUseError.stateUnavailable("read error \(error.rawValue)")
+            }, pause: { XCTFail("Uncertain read must stop") }))
+            XCTAssertEqual(writes, 1)
+            XCTAssertEqual(reads, 1)
+        }
+    }
+
+    func testCancellationDuringReadCannotBecomeSuccess() {
+        var cancelled = false
+        var writes = 0
+        XCTAssertThrowsError(try writeAccessibilityValueAndVerify(expected: kCFBooleanTrue, write: {
+            writes += 1; return .success
+        }, read: {
+            cancelled = true; return kCFBooleanTrue
+        }, pause: { XCTFail("Cancelled") }, checkCancellation: {
+            if cancelled { throw ComputerUseError.stateUnavailable("cancelled") }
+        }))
+        XCTAssertEqual(writes, 1)
+    }
+
+    func testUncertainWriteStopsBeforeReadOrReplay() {
+        var writes = 0
+        XCTAssertThrowsError(try writeAccessibilityValueAndVerify(expected: NSNumber(value: 42), write: {
+            writes += 1; return .cannotComplete
+        }, read: { XCTFail("Cannot infer completion"); return NSNumber(value: 42) }, pause: {}))
+        XCTAssertEqual(writes, 1)
+    }
+}
diff --git a/packages/OpenComputerUseKit/Tests/OpenComputerUseKitTests/AccessibilityValueTests.swift b/packages/OpenComputerUseKit/Tests/OpenComputerUseKitTests/AccessibilityValueTests.swift
