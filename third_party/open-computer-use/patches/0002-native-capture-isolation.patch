+        if ($handle -eq [IntPtr]$process.MainWindowHandle) { break }
+        $candidate = [Windows.Automation.TreeWalker]::ControlViewWalker.GetParent($candidate)
+    }
+    if ($target -eq [IntPtr]::Zero) { throw "No measurable UIA or native scrollbar viewport; precise page scrolling is unsupported" }
+    $sign = if ($direction -eq "up" -or $direction -eq "left") { -1 } else { 1 }
+    $maximum = [double]$info.nMax - $info.nPage + 1
+    $requested = [math]::Max([double]$info.nMin, [math]::Min([double]$maximum, $info.nPos + $sign * $pages * $info.nPage))
+    $desired = [int][math]::Round($requested)
+    $before = $info.nPos
+    if ($desired -eq $before -and $requested -ne $before) { throw "Requested scroll is smaller than the native scrollbar unit" }
+    $message = if ($axis -eq 0) { 0x0114 } else { 0x0115 }
+    if ($desired -ne $before) {
+        if ($desired -lt 0 -or $desired -gt 65535) { throw "Native scrollbar target exceeds 16-bit thumb message range; precise scrolling is unsupported" }
+        [uint32]$owner = 0
+        if ([OCUWin32]::GetWindowThreadProcessId($target, [ref]$owner) -eq 0 -or $owner -ne $process.Id -or
+            ($target -ne [IntPtr]$process.MainWindowHandle -and -not [OCUWin32]::IsChild([IntPtr]$process.MainWindowHandle, $target))) { throw "Scroll target process or window changed" }
+        $wparam = [IntPtr](($desired -shl 16) -bor 4)
+        if (-not [OCUWin32]::PostMessage($target, $message, $wparam, [IntPtr]::Zero)) { throw "Windows rejected native scrollbar input; it will not be replayed" }
+    }
+    $actual = $info
+    $distance = [math]::Abs($desired - $before)
+    $tolerance = [math]::Min([double]1, $distance * 0.1)
+    $reached = $false
+    for ($attempt = 0; $attempt -lt 10; $attempt++) {
+        $actual = [OCUWin32]::ReadScrollInfo($target, $axis)
+        $reached = [math]::Abs($actual.nPos - $desired) -le $tolerance -and ($distance -eq 0 -or ($actual.nPos - $before) * $sign -gt 0)
+        if ($reached) { break }
+        Start-Sleep -Milliseconds 20
+    }
+    if (-not $reached -or $actual.nPage -ne $info.nPage) {
+        throw "Native scrollbar did not reach the requested position; movement may be partial and will not be replayed"
+    }
+    $moved = [math]::Abs($actual.nPos - $before) / [double]$info.nPage
+    return "Scroll: requested $pages viewport pages $direction; observed $([math]::Round($moved, 4)) pages (native scrollbar, one-unit granularity)."
 }
 
