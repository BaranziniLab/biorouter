+
+func accessibilityValue(from text: String, currentValue: CFTypeRef) throws -> CFTypeRef {
+    switch CFGetTypeID(currentValue) {
+    case CFStringGetTypeID():
+        return text as CFString
+    case CFBooleanGetTypeID():
+        switch text {
+        case "true": return kCFBooleanTrue
+        case "false": return kCFBooleanFalse
+        default: throw ComputerUseError.invalidArguments("set_value requires 'true' or 'false' for this boolean control")
+        }
+    case CFNumberGetTypeID():
+        guard let number = Double(text), number.isFinite else {
+            throw ComputerUseError.invalidArguments("set_value requires a finite number for this numeric control")
+        }
+        return NSNumber(value: number)
+    default:
+        throw ComputerUseError.invalidArguments("set_value supports text, numeric, and boolean AX values; this control has an unsupported value type")
+    }
+}
+
+func writeAccessibilityValueAndVerify(
+    expected: CFTypeRef,
+    write: () -> AXError,
+    read: () throws -> CFTypeRef,
+    pause: () -> Void,
+    checkCancellation: () throws -> Void = ComputerUseCancellation.check
+) throws {
+    try checkCancellation()
+    let result = write()
+    guard result == .success else {
+        throw ComputerUseError.message("AX value write returned error \(result.rawValue); outcome is unconfirmed. Inspect before retrying.")
+    }
+    let deadline = ProcessInfo.processInfo.systemUptime + 1
+    for _ in 0..<20 {
+        try checkCancellation()
+        if ProcessInfo.processInfo.systemUptime >= deadline { break }
+        let observed = try read()
+        try checkCancellation()
+        if CFGetTypeID(observed) == CFGetTypeID(expected), CFEqual(observed, expected) { return }
+        pause()
+    }
+    throw ComputerUseError.stateUnavailable("set_value was acknowledged but the requested value was not observed. No alternate action was attempted. Inspect the control; if direct setting is unsupported, use an exposed Increment/Decrement action or drag intentionally.")
+}
+
+func validateScrollPages(_ pages: Double) throws {
+    guard pages.isFinite, pages > 0 else {
+        throw ComputerUseError.message("pages must be > 0")
+    }
+    guard pages <= 100 else {
+        throw ComputerUseError.invalidArguments("scroll supports at most 100 pages per call; inspect progress before requesting more")
+    }
+}
