+final class BioRouterCaptureContractTests: XCTestCase {
+    func testStandalonePermissionTargetsUseHelperName() {
+        let targets = NativePermissionTargets(helperBundleURL: URL(fileURLWithPath: "/Applications/BioRouter Computer Use.app"), helperName: "BioRouter Computer Use")
+        XCTAssertEqual(targets.accessibility, "BioRouter Computer Use")
+        XCTAssertEqual(targets.screenRecording, "BioRouter Computer Use")
+        XCTAssertEqual(targets.setupMessage, "Enable Accessibility and Screen Recording for BioRouter Computer Use in System Settings.")
+    }
+
+    func testNestedPermissionTargetsUseOutermostApplication() throws {
+        let directory = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+        defer { try? FileManager.default.removeItem(at: directory) }
+        let outer = directory.appendingPathComponent("Biorouter.app")
+        let inner = outer.appendingPathComponent("Contents/Resources/Intermediate.app")
+        try writePermissionTestBundle(at: outer, name: "Biorouter")
+        try writePermissionTestBundle(at: inner, name: "Intermediate")
+        let helper = inner.appendingPathComponent("Contents/Resources/BioRouter Computer Use.app")
+        let targets = NativePermissionTargets(helperBundleURL: helper, helperName: "BioRouter Computer Use")
+        XCTAssertEqual(targets.accessibility, "BioRouter Computer Use")
+        XCTAssertEqual(targets.screenRecording, "Biorouter")
+        XCTAssertEqual(targets.setupMessage, "Enable Accessibility for BioRouter Computer Use and Screen Recording for Biorouter in System Settings.")
+        XCTAssertEqual(targets.captureDeniedMessage, "screen_recording_permission_required: enable Screen Recording for Biorouter in System Settings, then retry")
+    }
+
+    func testPermissionTargetsIgnoreAppSuffixWithoutApplicationBundle() throws {
+        let directory = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+        defer { try? FileManager.default.removeItem(at: directory) }
+        let fakeApp = directory.appendingPathComponent("Documents.app")
+        try FileManager.default.createDirectory(at: fakeApp, withIntermediateDirectories: true)
+        let helper = fakeApp.appendingPathComponent("BioRouter Computer Use.app")
+        let targets = NativePermissionTargets(helperBundleURL: helper, helperName: "BioRouter Computer Use")
+        XCTAssertEqual(targets.screenRecording, "BioRouter Computer Use")
+    }
+
+    private func writePermissionTestBundle(at url: URL, name: String) throws {
+        let contents = url.appendingPathComponent("Contents")
+        try FileManager.default.createDirectory(at: contents, withIntermediateDirectories: true)
+        let info = ["CFBundlePackageType": "APPL", "CFBundleDisplayName": name, "CFBundleIdentifier": "org.biorouter.fixture.\(UUID().uuidString)"]
+        let data = try PropertyListSerialization.data(fromPropertyList: info, format: .xml, options: 0)
+        try data.write(to: contents.appendingPathComponent("Info.plist"))
+    }
+
+    func testPassiveDoctorCommandIsDistinctFromOnboarding() throws {
+        XCTAssertEqual(try parseOpenComputerUseCLI(arguments: ["doctor", "--json"]), .diagnostics)
+        XCTAssertEqual(try parseOpenComputerUseCLI(arguments: ["doctor"]), .doctor)
+    }
+
+    func testMalformedCaptureArguments() {
+        let cases: [[String: Any]] = [
+            ["display": -1], ["display": 0.5], ["display": true],
+            ["window_title": ""], ["window_title": 1], ["list_only": 1],
+            ["display": 0, "window_title": "example"], ["unknown": true],
+        ]
+        for arguments in cases {
+            XCTAssertThrowsError(try ScreenCaptureRequest(arguments: arguments))
+        }
+        XCTAssertNoThrow(try ScreenCaptureRequest(arguments: ["display": 0, "list_only": true]))
+    }
+
+    func testNewConnectionsRequireTheirOwnAppState() {
+        for server in [StdioMCPServer(), StdioMCPServer()] {
+            let line = #"{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"type_text","arguments":{"app":"missing-fixture","text":"must not type"}}}"#
+            let response = server.handle(line: line) ?? ""
+            XCTAssertTrue(response.contains("Run get_app_state before action tools"))
+            XCTAssertTrue(response.contains("\"isError\":true"))
+        }
+    }
+
+    func testCancellationIsOwnerScopedAndRestored() throws {
+        XCTAssertFalse(ComputerUseCancellation.isCancelled)
+        try ComputerUseCancellation.withProbe({ true }) {
+            XCTAssertThrowsError(try ComputerUseCancellation.check())
+            try ComputerUseCancellation.withProbe({ false }) {
+                XCTAssertNoThrow(try ComputerUseCancellation.check())
+            }
+            XCTAssertTrue(ComputerUseCancellation.isCancelled)
+        }
+        XCTAssertFalse(ComputerUseCancellation.isCancelled)
+    }
+
+    func testCaptureWaitCancelsOnOwnerDisconnect() throws {
+        try ComputerUseCancellation.withProbe({ true }) {
+            XCTAssertThrowsError(try BlockingAsyncBridge.run(timeout: 5) {
+                try await Task.sleep(nanoseconds: 5_000_000_000)
+                return true
+            })
+        }
+    }
