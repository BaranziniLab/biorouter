--- /dev/null
+++ b/packages/OpenComputerUseKit/Tests/OpenComputerUseKitTests/AccessibilityValueTests.swift
@@ -0,0 +1,39 @@
+import AppKit
+import XCTest
+@testable import OpenComputerUseKit
+
+final class AccessibilityValueTests: XCTestCase {
+    func testNumericValueUsesCFNumberInsteadOfString() throws {
+        let value = try accessibilityValue(from: "42", currentValue: NSNumber(value: 21))
+        XCTAssertEqual(CFGetTypeID(value), CFNumberGetTypeID())
+        XCTAssertEqual((value as? NSNumber)?.doubleValue, 42)
+        let fractional = try accessibilityValue(from: "12.5", currentValue: NSNumber(value: 0.5))
+        XCTAssertEqual((fractional as? NSNumber)?.doubleValue, 12.5)
+    }
+
+    func testBooleanValueUsesStrictCFBoolean() throws {
+        for text in ["true", "false"] {
+            let value = try accessibilityValue(from: text, currentValue: kCFBooleanFalse)
+            XCTAssertEqual(CFGetTypeID(value), CFBooleanGetTypeID())
+            XCTAssertEqual((value as? NSNumber)?.boolValue, text == "true")
+        }
+        for text in ["1", "0", "yes", "TRUE", ""] {
+            XCTAssertThrowsError(try accessibilityValue(from: text, currentValue: kCFBooleanTrue), text)
+        }
+    }
+
+    func testTextRemainsLiteral() throws {
+        for text in ["42", "false", "  text \n", ""] {
+            let value = try accessibilityValue(from: text, currentValue: "original" as CFString)
+            XCTAssertEqual(CFGetTypeID(value), CFStringGetTypeID())
+            XCTAssertEqual(value as? String, text)
+        }
+    }
+
+    func testNumericAndUnsupportedValuesRejectBeforeWriting() {
+        for text in ["NaN", "inf", "-Infinity", "1e999", "not a number", ""] {
+            XCTAssertThrowsError(try accessibilityValue(from: text, currentValue: NSNumber(value: 21)), text)
+        }
+        XCTAssertThrowsError(try accessibilityValue(from: "anything", currentValue: [] as CFArray))
+    }
+}
